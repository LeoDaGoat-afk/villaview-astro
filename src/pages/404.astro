---
// 404ページ。
// 2026-08-12 新設：これが無いと Cloudflare Pages が存在しないURLにも
// トップページを HTTP 200 で返す（ソフト404）。Googleはこれをエラーとして扱い、
// 存在しないURLが無限にインデックス候補になってクロール効率が落ちる。
//
// Astro は dist/404.html を出力し、Cloudflare Pages はそれを 404 で配信する。
// 言語は URL から判定できない（存在しないパスなので）ため、
// ブラウザの言語設定でクライアント側から文言を差し替える。既定は日本語。
// レイアウトは FaqContent と同じヒーロー型に揃えた（ヘッダーの文字が白のため、
// 背景が明るいとメニューが読めなくなる）。
import Layout from '../layouts/Layout.astro';
import { useT, localizedPath, withBase, LANGS } from '../i18n/utils';

const t = useT('ja');

// 全言語の文言を埋め込んでおき、クライアント側で選ぶ
const dict = Object.fromEntries(
  LANGS.map((l) => {
    const tt = useT(l.code);
    return [
      l.code,
      {
        heading: tt('nf.heading'),
        body: tt('nf.body'),
        home: tt('nf.cta.home'),
        booking: tt('nf.cta.booking'),
        homeHref: localizedPath('/', l.code),
        bookingHref: localizedPath('/booking/', l.code),
        htmlLang: l.htmlLang,
      },
    ];
  })
);
---

<Layout title={t('page.title.404')} description={t('page.desc.404')}>
  <section
    class="nf-hero"
    style={`background-image: linear-gradient(rgba(10,30,40,.55), rgba(10,30,40,.7)), url('${withBase('/images/hero-scenery.jpg')}')`}
  >
    <div class="nf-hero-inner">
      <p class="nf-code">404</p>
      <h1 class="nf-h1" id="nf-heading">{t('nf.heading')}</h1>
      <div class="nf-divider"></div>
    </div>
  </section>

  <section class="nf-section">
    <div class="nf-card">
      <p class="nf-body" id="nf-body">{t('nf.body')}</p>
      <div class="nf-cta">
        <a href={localizedPath('/', 'ja')} class="btn-primary" id="nf-home">{t('nf.cta.home')}</a>
        <a href={localizedPath('/booking/', 'ja')} class="btn-outline" id="nf-booking">{t('nf.cta.booking')}</a>
      </div>
    </div>
  </section>
</Layout>

<script is:inline define:vars={{ dict }}>
  (function () {
    try {
      var prefs =
        navigator.languages && navigator.languages.length
          ? navigator.languages
          : [navigator.language || 'ja'];
      var pick = null;
      for (var i = 0; i < prefs.length && !pick; i++) {
        var p = String(prefs[i]).toLowerCase();
        // 繁体字は zh-Hant / zh-TW / zh-HK を先に判定する（zh より前）
        if (/^zh-(hant|tw|hk|mo)/.test(p)) pick = 'zh-Hant';
        else if (/^zh/.test(p)) pick = 'zh';
        else {
          var base = p.split('-')[0];
          if (dict[base]) pick = base;
        }
      }
      if (!pick || !dict[pick] || pick === 'ja') return;
      var d = dict[pick];
      document.documentElement.setAttribute('lang', d.htmlLang);
      var set = function (id, text, href) {
        var el = document.getElementById(id);
        if (!el) return;
        el.textContent = text;
        if (href) el.setAttribute('href', href);
      };
      set('nf-heading', d.heading);
      set('nf-body', d.body);
      set('nf-home', d.home, d.homeHref);
      set('nf-booking', d.booking, d.bookingHref);
    } catch (e) {
      /* 文言の差し替えに失敗しても日本語のまま表示されればよい */
    }
  })();
</script>

<style>
  .nf-hero {
    background-size: cover;
    background-position: center center;
    padding: clamp(120px, 18vw, 200px) 20px clamp(60px, 8vw, 100px);
    color: #fff;
    text-align: center;
  }
  .nf-hero-inner {
    max-width: 820px;
    margin: 0 auto;
  }
  .nf-code {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 6px;
    opacity: 0.8;
    margin: 0 0 18px;
  }
  .nf-h1 {
    font-family: var(--font-serif);
    font-size: clamp(24px, 5vw, 40px);
    font-weight: 300;
    letter-spacing: 3px;
    margin: 0;
    line-height: 1.5;
  }
  .nf-divider {
    width: 60px;
    height: 1px;
    background: rgba(255, 255, 255, 0.6);
    margin: 28px auto 0;
  }

  .nf-section {
    padding: clamp(48px, 8vw, 80px) 20px clamp(64px, 10vw, 110px);
  }
  .nf-card {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
  }
  .nf-body {
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 2;
    margin: 0 0 40px;
  }
  .nf-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
  }
  @media (max-width: 480px) {
    .nf-cta {
      flex-direction: column;
    }
    .nf-cta a {
      width: 100%;
    }
    .nf-body {
      font-size: 14px;
      text-align: left;
    }
  }
</style>
