---
import Layout from '../../../layouts/Layout.astro';
import PolicyContent from '../../../components/PolicyContent.astro';
import { getLangFromPath, useT } from '../../../i18n/utils';
import { terms, pickPolicy } from '../../../lib/policy-content';

const lang = getLangFromPath(Astro.url.pathname);
const t = useT(lang);
const body = pickPolicy(terms, lang);
---
<Layout title={t('page.title.terms')}>
  <PolicyContent title={t('policy.terms.title')} body={body} />
</Layout>
