---
import Layout from '../../layouts/Layout.astro';
import PolicyContent from '../../components/PolicyContent.astro';
import { getLangFromPath, useT } from '../../i18n/utils';
import { contact, pickPolicy } from '../../lib/policy-content';

const lang = getLangFromPath(Astro.url.pathname);
const t = useT(lang);
const body = pickPolicy(contact, lang);
---
<Layout title={t('page.title.contact')}>
  <PolicyContent title={t('policy.contact.title')} body={body} />
</Layout>
