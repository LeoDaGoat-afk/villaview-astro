---

<div class="bw-widget" data-lang={lang}>
  <div class="bw-sub-banner">{dict.directDiscountSub}</div>

  <div class="bw-row">
    <div class="bw-grp">
      <label class="bw-lbl">{dict.checkIn}</label>
      <input id="bw-arrival" type="date" class="bw-input" />
    </div>
    <div class="bw-grp">
      <label class="bw-lbl">{dict.checkOut}</label>
      <input id="bw-departure" type="date" class="bw-input" />
    </div>
  </div>

  <div class="bw-grp">
    <div class="bw-cal-header">
      <button type="button" id="bw-prev" class="bw-cal-nav" aria-label="Prev month">◀</button>
      <div id="bw-cal-range" class="bw-cal-range">—</div>
      <button type="button" id="bw-next" class="bw-cal-nav" aria-label="Next month">▶</button>
    </div>
    <div class="bw-cal-legend">
      <span><span class="bw-cal-dot bw-cal-avail"></span>{dict.legendAvailable}</span>
      <span><span class="bw-cal-dot bw-cal-booked"></span>{dict.legendBooked}</span>
      <span><span class="bw-cal-dot bw-cal-selected"></span>{dict.legendSelected}</span>
    </div>
    <div id="bw-calendar" class="bw-cal-months">Loading…</div>
    <div id="bw-hint" class="bw-cal-hint">{dict.selectStartHint}</div>
  </div>

  <div class="bw-row3">
    <div class="bw-grp">
      <label class="bw-lbl">{dict.adults}</label>
      <div class="bw-num" data-counter="adults" data-min="1" data-max="10">
        <button type="button" data-act="-">−</button>
        <span data-val>2</span>
        <button type="button" data-act="+">+</button>
      </div>
    </div>
    <div class="bw-grp">
      <label class="bw-lbl">{dict.children}</label>
      <div class="bw-num" data-counter="children" data-min="0" data-max="6">
        <button type="button" data-act="-">−</button>
        <span data-val>0</span>
        <button type="button" data-act="+">+</button>
      </div>
    </div>
    <div class="bw-grp">
      <label class="bw-lbl">{dict.infants}</label>
      <div class="bw-num" data-counter="infants" data-min="0" data-max="6">
        <button type="button" data-act="-">−</button>
        <span data-val>0</span>
        <button type="button" data-act="+">+</button>
      </div>
      <div class="bw-info">{dict.infantFree}</div>
    </div>
  </div>

  <div id="bw-pricing" class="bw-pricecard" hidden></div>

  <div class="bw-row">
    <div class="bw-grp">
      <label class="bw-lbl">{dict.lastName}</label>
      <input id="bw-lastName" type="text" class="bw-input" />
    </div>
    <div class="bw-grp">
      <label class="bw-lbl">{dict.firstName}</label>
      <input id="bw-firstName" type="text" class="bw-input" />
    </div>
  </div>

  <div class="bw-row">
    <div class="bw-grp">
      <label class="bw-lbl">{dict.email}</label>
      <input id="bw-email" type="email" class="bw-input" />
    </div>
    <div class="bw-grp">
      <label class="bw-lbl">{dict.phone}</label>
      <input id="bw-phone" type="tel" class="bw-input" />
    </div>
  </div>

  <div class="bw-grp">
    <label class="bw-lbl">{dict.comment} {dict.optional}</label>
    <textarea id="bw-comment" class="bw-input" rows="3"></textarea>
  </div>

  <button id="bw-submit" type="button" class="bw-btn" disabled>{dict.book}</button>

  <div id="bw-msg" class="bw-msg" hidden></div>
</div>

<script is:inline define:vars={{ T, lang }}>
  (function() {
    const PROXY_BASE = "https://smartinn-api-proxy.leoroy225.workers.dev";
    const ROOM_ID = 674526;
    const PROPERTY_ID = 322452;
    const UP_TO_PERSON = 4;
    const EXTRA_PERSON_PRICE = 4000;
    const EXTRA_CHILD_PRICE = 2000;
    const CLEANING_FEE = 10000;
    const MAX_PEOPLE = 10;
    const DIRECT_DISCOUNT_RATE = 0.10;

    const t = T[lang] || T.ja;

    const $ = (id) => document.getElementById(id);
    const arrivalEl = $('bw-arrival');
    const departureEl = $('bw-departure');
    const calEl = $('bw-calendar');
    const hintEl = $('bw-hint');
    const pricingEl = $('bw-pricing');
    const submitBtn = $('bw-submit');
    const msgEl = $('bw-msg');

    function fmtJPY(n) { return "¥" + Math.round(n).toLocaleString("ja-JP"); }
    function todayISO() { return new Date().toISOString().slice(0, 10); }
    function addDays(iso, n) {
      const d = new Date(iso);
      d.setDate(d.getDate() + n);
      return d.toISOString().slice(0, 10);
    }
    function nightsBetween(a, b) {
      if (!a || !b) return 0;
      const ms = new Date(b) - new Date(a);
      return Math.max(0, Math.round(ms / 86400000));
    }

    const state = {
      arrival: addDays(todayISO(), 1),
      departure: addDays(todayISO(), 2),
      adults: 2,
      children: 0,
      infants: 0,
      displayMonth: new Date(new Date().getFullYear(), new Date().getMonth(), 1),
      availability: new Map(),
      calendar: null,
      submitting: false,
    };

    arrivalEl.value = state.arrival;
    departureEl.value = state.departure;
    arrivalEl.min = todayISO();
    departureEl.min = addDays(state.arrival, 1);

    arrivalEl.addEventListener('change', (e) => {
      state.arrival = e.target.value;
      if (!state.departure || state.departure <= state.arrival) {
        state.departure = addDays(state.arrival, 1);
        departureEl.value = state.departure;
      }
      departureEl.min = addDays(state.arrival, 1);
      const d = new Date(state.arrival);
      state.displayMonth = new Date(d.getFullYear(), d.getMonth(), 1);
      renderCalendar();
      fetchPricing();
    });
    departureEl.addEventListener('change', (e) => {
      state.departure = e.target.value;
      renderCalendar();
      fetchPricing();
    });

    // Counters
    document.querySelectorAll('[data-counter]').forEach((el) => {
      const key = el.getAttribute('data-counter');
      const min = parseInt(el.getAttribute('data-min'), 10);
      const max = parseInt(el.getAttribute('data-max'), 10);
      el.querySelectorAll('[data-act]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const delta = btn.getAttribute('data-act') === '+' ? 1 : -1;
          state[key] = Math.max(min, Math.min(max, state[key] + delta));
          el.querySelector('[data-val]').textContent = String(state[key]);
          fetchPricing();
        });
      });
    });

    function buildMonthGrid(year, month) {
      const firstDay = new Date(year, month, 1);
      const startDow = firstDay.getDay();
      const lastDay = new Date(year, month + 1, 0).getDate();
      const grid = [];
      for (let i = 0; i < startDow; i++) grid.push(null);
      for (let d = 1; d <= lastDay; d++) {
        const iso = `${year}-${String(month + 1).padStart(2, "0")}-${String(d).padStart(2, "0")}`;
        grid.push({ day: d, iso });
      }
      while (grid.length % 7 !== 0) grid.push(null);
      return grid;
    }

    function monthLabel(d) {
      const months = {
        ja: ['1月','2月','3月','4月','5月','6月','7月','8月','9月','10月','11月','12月'],
        zh: ['1月','2月','3月','4月','5月','6月','7月','8月','9月','10月','11月','12月'],
        'zh-Hant': ['1月','2月','3月','4月','5月','6月','7月','8月','9月','10月','11月','12月'],
        en: ['January','February','March','April','May','June','July','August','September','October','November','December'],
      };
      const m = (months[lang] || months.en)[d.getMonth()];
      return `${d.getFullYear()} ${m}`;
    }

    function weekdays() {
      const ws = {
        ja: ['日','月','火','水','木','金','土'],
        zh: ['日','一','二','三','四','五','六'],
        'zh-Hant': ['日','一','二','三','四','五','六'],
        ko: ['일','월','화','수','목','금','토'],
        en: ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'],
      };
      return ws[lang] || ws.en;
    }

    async function fetchAvailability() {
      const m = state.displayMonth;
      const start = `${m.getFullYear()}-${String(m.getMonth() + 1).padStart(2,'0')}-01`;
      const end = new Date(m.getFullYear(), m.getMonth() + 2, 0).toISOString().slice(0,10);
      try {
        const res = await fetch(`${PROXY_BASE}/beds24/proxy/inventory/rooms/calendar?roomId=${ROOM_ID}&startDate=${start}&endDate=${end}&includeNumAvail=true&includePrices=true`);
        const data = await res.json();
        const cal = (data && data.data && data.data[0] && data.data[0].calendar) || [];
        const map = new Map();
        for (const seg of cal) {
          const f = new Date(seg.from);
          const tt = new Date(seg.to);
          for (let d = new Date(f); d <= tt; d.setDate(d.getDate() + 1)) {
            const key = d.toISOString().slice(0,10);
            map.set(key, { numAvail: seg.numAvail, price: seg.price1 });
          }
        }
        state.availability = map;
      } catch (e) { state.availability = new Map(); }
      renderCalendar();
    }

    function fmtPriceShort(n) {
      if (n == null) return '';
      if (n >= 10000) return '¥' + Math.round(n / 1000) + 'k';
      return '¥' + Math.round(n / 100) / 10 + 'k';
    }

    function renderCalendar() {
      const today = todayISO();
      const m1 = state.displayMonth;
      const isMobile = window.innerWidth <= 700;
      const months = isMobile ? [m1] : [m1, new Date(m1.getFullYear(), m1.getMonth() + 1, 1)];
      const wds = weekdays();

      // Header range label
      const rangeEl = document.getElementById('bw-cal-range');
      if (rangeEl) {
        rangeEl.textContent = isMobile
          ? monthLabel(m1)
          : `${monthLabel(months[0])}  —  ${monthLabel(months[1])}`;
      }

      let html = '';
      for (const m of months) {
        const grid = buildMonthGrid(m.getFullYear(), m.getMonth());
        html += `<div class="bw-cal-month">`;
        html += `<div class="bw-cal-month-title">${monthLabel(m)}</div>`;
        html += `<div class="bw-cal-weekdays">${wds.map(w=>`<div class="bw-cal-wkd">${w}</div>`).join('')}</div>`;
        html += `<div class="bw-cal-grid">`;
        for (const cell of grid) {
          if (!cell) { html += '<div class="bw-cal-cell empty"></div>'; continue; }
          const isPast = cell.iso < today;
          const info = state.availability.get(cell.iso);
          const numAvail = info ? info.numAvail : undefined;
          const price = info ? info.price : null;
          const isBooked = numAvail !== undefined && numAvail === 0;
          const isArrival = cell.iso === state.arrival;
          const isDeparture = cell.iso === state.departure;
          const inRange = state.arrival && state.departure && cell.iso > state.arrival && cell.iso < state.departure;
          let cls = 'bw-cal-cell';
          if (isPast) cls += ' past';
          else if (isBooked) cls += ' booked';
          else if (isArrival || isDeparture) cls += ' selected';
          else if (inRange) cls += ' inrange';
          else cls += ' avail';
          const disabled = isPast || isBooked ? 'disabled' : '';
          const priceLabel = (!isPast && !isBooked && price) ? `<span class="bw-cal-price">${fmtPriceShort(price)}</span>` : '';
          html += `<button type="button" class="${cls}" data-iso="${cell.iso}" ${disabled}><span class="bw-cal-day">${cell.day}</span>${priceLabel}</button>`;
        }
        html += `</div></div>`;
      }
      calEl.innerHTML = html;

      calEl.querySelectorAll('[data-iso]:not([disabled])').forEach((btn) => {
        btn.addEventListener('click', () => {
          const iso = btn.getAttribute('data-iso');
          if (!state.arrival || (state.arrival && state.departure)) {
            state.arrival = iso;
            state.departure = '';
          } else if (iso <= state.arrival) {
            state.arrival = iso;
            state.departure = '';
          } else {
            state.departure = iso;
          }
          arrivalEl.value = state.arrival;
          departureEl.value = state.departure;
          updateHint();
          renderCalendar();
          fetchPricing();
        });
      });
      updateHint();
    }

    function updateHint() {
      const n = nightsBetween(state.arrival, state.departure);
      if (!state.arrival) hintEl.textContent = t.selectStartHint;
      else if (!state.departure) hintEl.textContent = t.selectEndHint;
      else hintEl.textContent = `${state.arrival} → ${state.departure} (${n}${t.nights})`;
    }

    async function fetchPricing() {
      const nights = nightsBetween(state.arrival, state.departure);
      if (nights < 1) { pricingEl.hidden = true; submitBtn.disabled = true; return; }
      const endMinus = addDays(state.departure, -1);
      const url = `${PROXY_BASE}/beds24/proxy/inventory/rooms/calendar?roomId=${ROOM_ID}&startDate=${state.arrival}&endDate=${endMinus}&includePrices=true&includeNumAvail=true`;
      try {
        const res = await fetch(url);
        const data = await res.json();
        state.calendar = (data && data.data && data.data[0] && data.data[0].calendar) || [];
      } catch (e) { state.calendar = []; }
      renderPricing();
    }

    function computePricing() {
      const nights = nightsBetween(state.arrival, state.departure);
      if (!state.calendar || nights < 1) return null;
      const dayMap = new Map();
      for (const seg of state.calendar) {
        const f = new Date(seg.from);
        const tt = new Date(seg.to);
        for (let d = new Date(f); d <= tt; d.setDate(d.getDate() + 1)) {
          dayMap.set(d.toISOString().slice(0,10), seg);
        }
      }
      let basePerNight = 0;
      let allAvailable = true;
      let allHavePrice = true;
      for (let i = 0; i < nights; i++) {
        const dateKey = addDays(state.arrival, i);
        const seg = dayMap.get(dateKey);
        if (!seg) { allAvailable = false; allHavePrice = false; continue; }
        if (seg.numAvail === 0) allAvailable = false;
        if (seg.price1 == null) allHavePrice = false;
        basePerNight += seg.price1 || 0;
      }
      const extraAdults = Math.max(0, state.adults - UP_TO_PERSON);
      const extraAdultsCharge = extraAdults * EXTRA_PERSON_PRICE * nights;
      const childrenCharge = state.children * EXTRA_CHILD_PRICE * nights;
      const subtotal = basePerNight + extraAdultsCharge + childrenCharge + CLEANING_FEE;
      const discount = Math.round(subtotal * DIRECT_DISCOUNT_RATE);
      const total = subtotal - discount;
      return { basePerNight, extraAdults, extraAdultsCharge, childrenCharge, subtotal, discount, total, allAvailable, allHavePrice, nights };
    }

    function renderPricing() {
      const p = computePricing();
      if (!p) { pricingEl.hidden = true; submitBtn.disabled = true; return; }
      pricingEl.hidden = false;
      if (!p.allAvailable || !p.allHavePrice) {
        pricingEl.innerHTML = `<div class="bw-na">${t.notAvailable}</div>`;
        submitBtn.disabled = true;
        return;
      }
      let html = '';
      html += `<div class="bw-price-row"><span>${t.basePrice} (${p.nights === 1 ? t.night : p.nights + t.nights} × ${t.upTo4})</span><span>${fmtJPY(p.basePerNight)}</span></div>`;
      if (p.extraAdultsCharge > 0) html += `<div class="bw-price-row"><span>${t.extraGuests} (${t.extraPerson} × ${p.extraAdults} × ${p.nights}${t.nights})</span><span>${fmtJPY(p.extraAdultsCharge)}</span></div>`;
      if (p.childrenCharge > 0) html += `<div class="bw-price-row"><span>${t.extraChild} × ${state.children} × ${p.nights}${t.nights}</span><span>${fmtJPY(p.childrenCharge)}</span></div>`;
      html += `<div class="bw-price-row"><span>${t.cleaning}</span><span>${fmtJPY(CLEANING_FEE)}</span></div>`;
      html += `<div class="bw-price-row bw-pre-discount"><span>${t.subtotal}</span><span class="bw-strike">${fmtJPY(p.subtotal)}</span></div>`;
      html += `<div class="bw-price-row bw-discount-row"><span>▌ ${t.discount} (−10%)</span><span>−${fmtJPY(p.discount)}</span></div>`;
      html += `<div class="bw-price-row bw-total"><span>${t.finalTotal}</span><span>${fmtJPY(p.total)}</span></div>`;
      html += `<div class="bw-note">✓ ${t.allIncluded}</div>`;
      html += `<div class="bw-saved">${t.savingNote} ${fmtJPY(p.discount)} ${t.saved}</div>`;
      html += `<div class="bw-cancel"><div class="bw-cancel-title">▌ ${t.cancelTitle}</div><div>${t.cancelText}</div></div>`;
      pricingEl.innerHTML = html;
      submitBtn.disabled = false;
    }

    // Submit
    submitBtn.addEventListener('click', async () => {
      if (state.submitting) return;
      const p = computePricing();
      if (!p || !p.allAvailable || !p.allHavePrice) return;
      const firstName = $('bw-firstName').value.trim();
      const lastName = $('bw-lastName').value.trim();
      const email = $('bw-email').value.trim();
      const phone = $('bw-phone').value.trim();
      const comment = $('bw-comment').value.trim();
      if (!firstName || !lastName) { showMsg(t.nameRequired, 'error'); return; }
      if (!email) { showMsg(t.emailRequired, 'error'); return; }
      if (!phone) { showMsg(t.phoneRequired, 'error'); return; }

      state.submitting = true;
      submitBtn.disabled = true;
      submitBtn.textContent = t.booking;
      const payload = [{
        propertyId: PROPERTY_ID, roomId: ROOM_ID, offerId: 1, status: 'new',
        arrival: state.arrival, departure: state.departure,
        numAdult: state.adults, numChild: state.children,
        firstName, lastName, email, phone, comments: comment,
        lang, referer: 'direct', channel: 'direct',
        price: p.total, deposit: p.total,
        invoiceItems: [{ type: 'charge', description: `${state.arrival}〜${state.departure} ${p.nights}泊`, qty: 1, amount: p.total, vatRate: 0 }],
        allowWebhooks: 'all',
      }];
      try {
        const res = await fetch(`${PROXY_BASE}/beds24/proxy/bookings`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload),
        });
        const data = await res.json();
        const ok = Array.isArray(data) ? data[0]?.success : data?.success;
        const newBookingId = Array.isArray(data) ? data[0]?.new?.id : null;
        if (ok) {
          showMsg(t.success, 'success');
          if (newBookingId) {
            // Notify worker webhook
            fetch(`${PROXY_BASE}/webhook/beds24`, {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                id: String(newBookingId), propertyId: PROPERTY_ID, roomId: ROOM_ID,
                status: 'new', arrival: state.arrival, departure: state.departure,
                numAdult: state.adults, numChild: state.children,
                firstName, lastName, email, phone, comments: comment,
                price: p.total, currency: 'JPY', apiSource: 'Direct',
                referer: 'direct', channel: 'direct', lang,
              }),
            }).catch(()=>{});
            setTimeout(() => {
              const payLang = lang === 'zh' || lang === 'zh-Hant' ? 'zh' : lang === 'en' ? 'en' : 'ja';
              window.location.href = `https://beds24.com/bookpay.php?bookid=${newBookingId}&pay=bookbalance&lang=${payLang}`;
            }, 1500);
          }
        } else {
          showMsg(t.error, 'error');
        }
      } catch (e) {
        showMsg(t.error, 'error');
      } finally {
        state.submitting = false;
        submitBtn.textContent = t.book;
      }
    });

    function showMsg(text, kind) {
      msgEl.textContent = text;
      msgEl.className = 'bw-msg ' + (kind || '');
      msgEl.hidden = false;
    }

    // Calendar nav
    $('bw-prev').addEventListener('click', () => {
      const now = new Date();
      const cur = state.displayMonth;
      if (cur.getFullYear() === now.getFullYear() && cur.getMonth() <= now.getMonth()) return;
      state.displayMonth = new Date(cur.getFullYear(), cur.getMonth() - 1, 1);
      fetchAvailability();
    });
    $('bw-next').addEventListener('click', () => {
      const cur = state.displayMonth;
      state.displayMonth = new Date(cur.getFullYear(), cur.getMonth() + 1, 1);
      fetchAvailability();
    });

    // Re-render on resize crossing the mobile breakpoint
    let lastMobile = window.innerWidth <= 700;
    window.addEventListener('resize', () => {
      const nowMobile = window.innerWidth <= 700;
      if (nowMobile !== lastMobile) {
        lastMobile = nowMobile;
        renderCalendar();
      }
    });

    // Init
    fetchAvailability();
    fetchPricing();
  })();
</script>

