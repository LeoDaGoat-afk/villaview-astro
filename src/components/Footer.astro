---
import { getLangFromPath, useT, localizedPath } from '../i18n/utils';

const lang = getLangFromPath(Astro.url.pathname);
const t = useT(lang);

const links = [
  { href: localizedPath('/privacy/', lang), label: t('footer.privacy') },
  { href: localizedPath('/terms/', lang), label: t('footer.terms') },
  { href: localizedPath('/contact/', lang), label: t('footer.contact') },
  { href: localizedPath('/tokushoho/', lang), label: t('footer.tokushoho') },
];
---

<footer class="vv-footer">
  <div class="vv-footer-inner">
    <p class="vv-footer-logo">VILLA VIEW</p>
    <p class="vv-footer-tag">{t('site.tagline')}</p>

    <div class="vv-footer-meta">
      <p>{t('footer.address')}</p>
      <p>
        <a href={`tel:${t('footer.tel').replace(/[^0-9+]/g,'')}`}>Tel: {t('footer.tel')}</a>
        <span class="vv-sep">·</span>
        <a href={`mailto:${t('footer.email')}`}>{t('footer.email')}</a>
      </p>
    </div>

    <nav class="vv-footer-links">
      {links.map(l => <a href={l.href}>{l.label}</a>)}
    </nav>

    <p class="vv-footer-copy">{t('footer.copyright')}</p>
  </div>
</footer>

<style>
  .vv-footer {
    background: var(--color-primary-darker);
    color: #fff;
    padding: clamp(50px, 8vw, 80px) clamp(20px, 5vw, 80px) 36px;
    text-align: center;
  }
  .vv-footer-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .vv-footer-logo {
    font-family: var(--font-serif);
    font-size: 24px;
    letter-spacing: 8px;
    font-weight: 300;
    margin: 0 0 12px;
  }
  .vv-footer-tag {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    opacity: 0.6;
    margin: 0 0 28px;
  }
  .vv-footer-meta {
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 1.9;
    opacity: 0.75;
    margin-bottom: 24px;
  }
  .vv-footer-meta p { margin: 4px 0; }
  .vv-footer-meta a {
    color: inherit;
    text-decoration: none;
  }
  .vv-footer-meta a:hover { opacity: 1; color: var(--color-accent); }
  .vv-sep { padding: 0 10px; opacity: 0.4; }
  .vv-footer-links {
    display: flex;
    gap: 28px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  .vv-footer-links a {
    color: rgba(255, 255, 255, 0.55);
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    transition: color 0.3s;
  }
  .vv-footer-links a:hover { color: #fff; }
  .vv-footer-copy {
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 2px;
    opacity: 0.35;
    margin: 0;
  }

  @media (max-width: 600px) {
    .vv-sep { display: none; }
    .vv-footer-meta p { display: flex; flex-direction: column; gap: 4px; }
  }
</style>
