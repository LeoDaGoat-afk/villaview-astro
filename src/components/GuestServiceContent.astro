---
import { getLangFromPath, useT, localizedPath } from '../i18n/utils';

const lang = getLangFromPath(Astro.url.pathname);
const t = useT(lang);
const homeHref = localizedPath('/', lang);
---
  <section class="gs-section">
    <div class="gs-card">
      <p class="eyebrow">VILLA VIEW</p>
      <h1>{t('guest.title')}</h1>
      <div class="vv-divider-gold-center"></div>
      <p class="gs-sub">{t('guest.sub')}</p>

      <div class="gs-tabs">
        <button class="gs-tab active" data-tab="checkin">{t('guest.tab.checkin')}</button>
        <button class="gs-tab" data-tab="checkout">{t('guest.tab.checkout')}</button>
        <button class="gs-tab" data-tab="status">{t('guest.tab.status')}</button>
      </div>

      <form class="gs-form" id="gs-form" onsubmit="return false;">
        <label class="gs-lbl">{t('guest.bookingId')}</label>
        <input id="gs-bid" class="gs-input" type="text" placeholder={t('guest.bookingId.placeholder')} />
        <button id="gs-search" class="btn-primary gs-search">{t('guest.search')}</button>
        <p id="gs-msg" class="gs-msg" hidden></p>
      </form>

      <div class="gs-notice">
        <p>{t('guest.notReady')}</p>
      </div>

      <p class="gs-back">
        <a class="btn-outline" href={homeHref}>{t('common.backHome')}</a>
      </p>
    </div>
  </section>

<script is:inline>
  (function() {
    const tabs = document.querySelectorAll('.gs-tab');
    tabs.forEach(t => t.addEventListener('click', () => {
      tabs.forEach(x => x.classList.remove('active'));
      t.classList.add('active');
    }));
    const PROXY = 'https://smartinn-api-proxy.leoroy225.workers.dev';
    document.getElementById('gs-search')?.addEventListener('click', async () => {
      const bid = document.getElementById('gs-bid').value.trim();
      const msg = document.getElementById('gs-msg');
      if (!bid) {
        msg.textContent = 'Please enter a Booking ID.';
        msg.hidden = false;
        msg.className = 'gs-msg error';
        return;
      }
      msg.textContent = 'Searching...';
      msg.hidden = false;
      msg.className = 'gs-msg';
      try {
        const res = await fetch(`${PROXY}/beds24/proxy/bookings?id=${encodeURIComponent(bid)}`);
        const data = await res.json();
        const b = (data.data || [])[0];
        if (b) {
          msg.textContent = `Booking #${b.id} · ${b.arrival} → ${b.departure}`;
          msg.className = 'gs-msg success';
        } else {
          msg.textContent = 'Booking not found.';
          msg.className = 'gs-msg error';
        }
      } catch {
        msg.textContent = 'Lookup failed. Please try again.';
        msg.className = 'gs-msg error';
      }
    });
  })();
</script>

<style>
  .gs-section {
    min-height: 80vh;
    padding: clamp(100px, 14vw, 160px) 20px 80px;
    background: var(--color-cream);
  }
  .gs-card {
    max-width: 560px;
    margin: 0 auto;
    background: #fff;
    border: 1px solid var(--color-cream-darker);
    border-radius: 14px;
    padding: clamp(28px, 5vw, 56px);
    text-align: center;
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.04);
  }
  h1 {
    font-family: var(--font-serif);
    font-size: clamp(26px, 4vw, 36px);
    font-weight: 300;
    color: var(--color-ink);
    letter-spacing: 2px;
    margin: 0 0 8px;
  }
  .gs-sub {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--color-muted);
    margin: 0 0 32px;
  }
  .gs-tabs {
    display: flex;
    gap: 4px;
    background: var(--color-cream-dark);
    padding: 4px;
    border-radius: 8px;
    margin-bottom: 24px;
  }
  .gs-tab {
    flex: 1;
    padding: 10px 12px;
    border: none;
    background: transparent;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--color-muted);
    border-radius: 6px;
    letter-spacing: 1px;
    transition: background 0.2s, color 0.2s;
  }
  .gs-tab.active { background: #fff; color: var(--color-primary); font-weight: 500; }
  .gs-form { text-align: left; }
  .gs-lbl {
    display: block;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 6px;
    font-weight: 500;
  }
  .gs-input {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--color-cream-darker);
    border-radius: 8px;
    font-size: 14px;
    font-family: inherit;
    background: #fff;
    margin-bottom: 12px;
  }
  .gs-search { width: 100%; }
  .gs-msg {
    padding: 10px 14px;
    border-radius: 6px;
    font-family: var(--font-sans);
    font-size: 12px;
    margin-top: 12px;
    background: var(--color-cream-dark);
  }
  .gs-msg.error { background: #fbeaea; color: #8a2424; }
  .gs-msg.success { background: #e8f3ec; color: #1c5b35; }
  .gs-notice {
    margin-top: 28px;
    padding: 16px;
    background: rgba(42, 90, 110, 0.06);
    border-left: 3px solid var(--color-primary);
    border-radius: 4px;
    text-align: left;
  }
  .gs-notice p {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--color-ink-soft);
    line-height: 1.7;
    margin: 0;
  }
  .gs-back { margin-top: 28px; }
</style>
