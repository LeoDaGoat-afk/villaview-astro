---
import { getLangFromPath, useT, localizedPath, withBase } from '../i18n/utils';

const lang = getLangFromPath(Astro.url.pathname);
const t = useT(lang);

// Pick row by lang: 0=en, 1=ja, 2=zh, otherwise fall back to en
const pickIdx = (() => {
  if (lang === 'ja') return 1;
  if (lang === 'zh' || lang === 'zh-Hant') return 2;
  return 0;
})();
const p = (s: string) => s.split('|')[pickIdx] ?? s.split('|')[0];

// Hero slides: photos hold for 5s, videos play through at their natural length
// (durationFallback is only used when video.duration cannot be read).
type HeroSlide = {
  src: string;
  type: 'image' | 'video';
  poster?: string;
  durationFallback?: number;
  // 尺の短いクリップ用の追い足し時間。クリップが終わったあと、この分だけ
  // 最後のコマのまま残ってから溶け始める（フェード中なので静止には見えない）。
  extraHoldMs?: number;
};
const heroSlides: HeroSlide[] = [
  { src: '/images/hero-bedroom.jpg', type: 'image' },
  { src: '/images/hero-drone-1.mp4', type: 'video', poster: '/images/hero-drone-1-poster.jpg', durationFallback: 7.1 },
  { src: '/images/hero-bar.jpg',     type: 'image' },
  { src: '/images/hero-cafe.jpg',    type: 'image' },
  { src: '/images/hero-drone-2.mp4', type: 'video', poster: '/images/hero-drone-2-poster.jpg', durationFallback: 5.8, extraHoldMs: 1800 },
  { src: '/images/hero-hall.jpg',    type: 'image' },
  { src: '/images/night-view.jpg',   type: 'image' },
];

const facilities = [
  { img: '/images/guestroom/bedroom-oceanview.jpg', titleKey: 'facility.room.title',    descKey: 'facility.room.desc' },
  { img: '/images/coffee/coffeearea2.jpg',           titleKey: 'facility.coffee.title',  descKey: 'facility.coffee.desc' },
  { img: '/images/yogastudio/IMG_4715.jpg',          titleKey: 'facility.yoga.title',    descKey: 'facility.yoga.desc' },
  { img: '/images/bbq/IMG_7211.jpg',                 titleKey: 'facility.bbq.title',     descKey: 'facility.bbq.desc' },
  { img: '/images/therapy/IMG_5915.jpg',             titleKey: 'facility.therapy.title', descKey: 'facility.therapy.desc' },
  { img: '/images/guestroom/terrace.jpg',            titleKey: 'facility.minibar.title', descKey: 'facility.minibar.desc' },
];

const galleryImages: { src: string; altKey: string }[] = [
  { src: '/images/guestroom/guestroom-oceanview.jpg',    altKey: 'photo.bedroomSea' },
  { src: '/images/guestroom/bedroom-oceanview.jpg',      altKey: 'photo.bedroom' },
  { src: '/images/guestroom/living-room.jpg',            altKey: 'photo.living' },
  { src: '/images/guestroom/terrace.jpg',                altKey: 'photo.terrace' },
  { src: '/images/guestroom/washitu.jpg',                altKey: 'photo.washitsu' },
  { src: '/images/yogastudio/living-room-oceanview.jpg', altKey: 'photo.hallSea' },
  { src: '/images/yogastudio/IMG_4715.jpg',              altKey: 'photo.hall' },
  { src: '/images/yogastudio/bancony.jpg',               altKey: 'photo.balcony' },
  { src: '/images/bbq/IMG_7211.jpg',                     altKey: 'photo.bbq' },
  { src: '/images/coffee/coffeearea2.jpg',               altKey: 'photo.desk' },
  { src: '/images/therapy/IMG_5915.jpg',                 altKey: 'photo.sauna' },
  { src: '/images/minibar/ballparty.jpg',                altKey: 'photo.hallParty' },
];

const restaurants: [string, string, string, number][] = [
  ['CAFE&BAR GarageLife|カフェ＆バー ガレージライフ|GarageLife', 'American · Burgers|アメリカン・バーガー|美式汉堡', '+81 80-3998-5885', 4.7],
  ['Okinawa Soba Maruchi|沖縄そば まるち|冲绳荞麦 Maruchi', 'Okinawa Soba|沖縄そば|冲绳荞麦面', '+81 98-917-5850', 4.4],
  ['Laurel|ローレル|Laurel 墨西哥', 'Mexican · Tacos|メキシカン・タコス|墨西哥菜·塔可', '+81 98-917-6084', 4.8],
  ['Kakinohana Soba|柿の花そば|柿花荞麦面', 'Japanese · Soba|沖縄そば|日式荞麦面', '+81 70-8506-0238', 4.6],
  ['modica|モディカ|modica 巧克力', 'Chocolate · Coffee|チョコレート・コーヒー|巧克力·咖啡', '+81 80-6494-7309', 4.6],
  ['France Shokudo 1663|フランス食堂1663|法式食堂1663', 'French · Italian|フレンチ・イタリアン|法式·意式', '', 0],
];

const attractions: [string, string, number, string, string][] = [
  ['Sefa Utaki|斎場御嶽|斋场御嶽', 'UNESCO Heritage|世界遺産|世界遗产', 4.3, '/images/attractions/sefa-utaki.jpg', 'Most sacred Ryukyu site.|琉球最高聖地。|琉球最神圣之地。'],
  ['Nanjo Museum|南城美術館|南城美术馆', 'Contemporary Art|現代アート|当代艺术', 4.2, '/images/attractions/nanjo-museum.jpg', 'Hilltop art museum with ocean views.|丘の上の美術館。海景。|山丘上的美术馆，海景。'],
  ['Gyokusendo Cave|玉泉洞|玉泉洞', 'Natural Wonder|自然の驚異|自然奇观', 4.4, '/images/attractions/gyokusendo.jpg', "One of Japan's largest limestone caves.|日本最大級鍾乳洞。|日本最大石灰岩洞。"],
  ['Valley of Gangala|ガンガラーの谷|Gangala山谷', 'Guided Tour|ガイドツアー|自然导览', 4.4, '/images/attractions/gangala.jpg', 'Mystical valley with ancient caves.|神秘の谷。|远古洞穴森林。'],
  ['Cape Chinen Park|知念岬公園|知念岬公园', 'Scenic Viewpoint|絶景スポット|绝美观景', 4.4, '/images/attractions/chinen-cape.jpg', 'Best sunrise spot in Okinawa.|沖縄屈指の日の出スポット。|冲绳最佳日出观景点。'],
  ['Nirai Kanai Bridge|ニライカナイ橋|Nirai Kanai大桥', 'Scenic Drive|絶景ドライブ|绝美兜风', 4.4, '/images/attractions/niraikanai.jpg', 'S-curve bridge descending toward the ocean.|海に向かうS字カーブ。|通往大海的S形弯桥。'],
];

const beaches: [string, string, number, string][] = [
  ['Kudaka Island|久高島|久高岛', 'Sacred Island|神の島|神之岛', 4.6, '/images/attractions/kudaka-ferry.jpg'],
  ['Ojima Island|奥武島|奥武岛', 'Cat Island|猫の島|猫之岛', 4.4, '/images/attractions/ojima.jpg'],
  ['Mibaru Beach|みーばるビーチ|美巴鲁海滩', 'Natural Beach|天然ビーチ|天然海滩', 4.2, '/images/attractions/mibaru.jpg'],
  ['Hyakuna Beach|百名ビーチ|百名海滩', 'Secluded|穴場|私密海滩', 4.3, '/images/attractions/hyakuna-beach.jpg'],
  ['Azama Sun Sun Beach|あざまサンサンビーチ|安座真阳光海滩', 'Family Beach|ファミリー|家庭海滩', 4.1, '/images/attractions/azama.jpg'],
];

const beds24LangMap: Record<string, string> = {
  'zh-Hant': 'zh-Hant', ja: 'ja', en: 'en', zh: 'zh',
  ko: 'ko', th: 'th', hi: 'hi', fr: 'fr', de: 'de', es: 'es',
};
const bookingHref = `https://beds24.com/booking2.php?propid=322452&lang=${beds24LangMap[lang] ?? 'ja'}&numnight=1`;
const guestHref = localizedPath('/guest-service/', lang);
---

<!-- HERO -->
<section class="vv-hero">
  <div class="vv-hero-slides">
    {heroSlides.map((slide, i) => (
      slide.type === 'video' ? (
        <video
          src={withBase(slide.src)}
          poster={slide.poster ? withBase(slide.poster) : undefined}
          class:list={['vv-hero-media', 'vv-hero-video', i === 0 ? 'active' : '']}
          data-idx={i}
          data-duration={slide.durationFallback}
          data-extra-hold={slide.extraHoldMs}
          preload="none"
          muted
          playsinline
          aria-hidden="true"
          tabindex="-1"
        />
      ) : (
        <img
          src={withBase(slide.src)}
          alt="VILLA VIEW Okinawa"
          class:list={['vv-hero-media', 'vv-hero-img', i === 0 ? 'active' : '']}
          data-idx={i}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'auto'}
        />
      )
    ))}
  </div>
  <div class="vv-hero-overlay"></div>
  <div class="vv-hero-content">
    <p class="vv-hero-eyebrow">{t('hero.eyebrow')}</p>
    <img
      class="vv-hero-illust"
      src={withBase('/images/hero-illust.png')}
      alt=""
      aria-hidden="true"
      width="1200"
      height="675"
      fetchpriority="high"
    />
    <h1 class="vv-hero-title">{t('hero.title')}</h1>
    <p class="vv-hero-rating">{t('hero.rating')}</p>
  </div>
</section>

<!-- BOOKING BAR：ヒーロー直下の予約ブロック（るうふ杉之家と同じ位置・同じ役割）。
     ヒーローから外したCTAはここが引き受ける。送り先は Beds24。 -->
<section class="vv-bookbar" aria-label={t('booking.heading')}>
  <div class="vv-bookbar-inner">
    <div class="vv-bookbar-field">
      <label for="vv-bb-in">{t('bookbar.checkin')}</label>
      <input type="date" id="vv-bb-in" />
    </div>
    <div class="vv-bookbar-field">
      <label for="vv-bb-out">{t('bookbar.checkout')}</label>
      <input type="date" id="vv-bb-out" />
    </div>
    <div class="vv-bookbar-flex">
      <input type="checkbox" id="vv-bb-flex" />
      <label for="vv-bb-flex">{t('bookbar.flexible')}</label>
    </div>
    <div class="vv-bookbar-field vv-bookbar-guests">
      <label for="vv-bb-guests">{t('bookbar.guests')}</label>
      <select id="vv-bb-guests">
        {[1,2,3,4,5,6,7,8].map(n => (
          <option value={n} selected={n === 4}>{n}</option>
        ))}
      </select>
    </div>
    <a href={bookingHref} class="vv-bookbar-submit" id="vv-bb-go">{t('bookbar.submit')}</a>
  </div>
</section>

<!-- EXPERIENCE：るうふ杉之家の同名ブロックを実測して移植（2026-09-03）。
     左に大判写真、右上に極細グレーの大見出し、その下に縦書きのリード文。
     リード文はアキラさん本人の確定稿（memory: project_villaview_toppage_redesign 末尾）。
     カード3枚は未設計のため、まだ置いていない。 -->
<section id="experience" class="vv-exp">
  <div class="vv-exp-inner">
    <img
      class="vv-exp-photo"
      src={withBase('/images/experience-lead.jpg')}
      alt="窓の外に海と街並みが広がるカフェスペースで、テーブルを囲む家族"
      width="1157"
      height="748"
      loading="lazy"
      decoding="async"
    />
    <div class="vv-exp-text">
      <p class="vv-exp-heading" aria-hidden="true">Experience</p>
      <h2 class="vv-exp-lead">{t('experience.lead')}</h2>
    </div>
  </div>
</section>

<!-- CONCEPT：2026-09-04 アキラさん指示で Experience の下へ移動し、
     Experience と同じ形（左に大判写真・右上に極細グレーの英字見出し・その下に本文）に
     組み替えた。トンマナを確実に揃えるため CSS は .vv-exp 系をそのまま共有している。
     「この宿について」の日本語ラベルは廃止し、英字見出し `Space` に置き換え。 -->
<section id="vv-concept-sec" class="vv-exp">
  <div class="vv-exp-inner">
    <img
      class="vv-exp-photo"
      src={withBase('/images/concept-photo.jpg')}
      alt="海に面した窓と、白いベッドが2台ならぶ寝室"
      width="1600"
      height="1066"
      loading="lazy"
      decoding="async"
    />
    <div class="vv-exp-text">
      <p class="vv-exp-heading" aria-hidden="true">Space</p>
      <h2 class="vv-concept-title">{t('concept.title')}</h2>
      <p class="vv-exp-lead">{t('concept.body')}</p>
    </div>
  </div>
</section>

<!-- FACILITIES -->
<section id="facilities" class="vv-section">
  <div class="vv-container">
    <div class="vv-text-center vv-section-head">
      <p class="eyebrow">{t('facilities.eyebrow')}</p>
      <h2 class="section-h2">{t('facilities.title')}</h2>
      <div class="vv-divider-gold-center"></div>
      <p class="section-lead vv-mx-auto">{t('facilities.lead')}</p>
    </div>
    <div class="vv-grid-3">
      {facilities.map(f => (
        <article class="vv-fac-card">
          <div class="vv-fac-img-wrap">
            <img src={withBase(f.img)} alt={t(f.titleKey)} loading="lazy" />
          </div>
          <div class="vv-fac-body">
            <h3>{t(f.titleKey)}</h3>
            <p>{t(f.descKey)}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- DEALS -->
<section class="vv-section vv-section-cream">
  <div class="vv-container">
    <div class="vv-text-center vv-section-head">
      <p class="eyebrow">{t('deals.eyebrow')}</p>
      <h2 class="section-h2">{t('deals.title')}</h2>
      <div class="vv-divider-gold-center"></div>
      <p class="section-lead vv-mx-auto">{t('deals.lead')}</p>
    </div>
    <div class="vv-grid-2">
      <article class="vv-deal-card">
        <img src={withBase('/images/lawson.jpg')} alt="LAWSON" loading="lazy" />
        <div class="vv-deal-body">
          <h3>{t('deals.lawson.title')}</h3>
          <p>{t('deals.lawson.body')}</p>
        </div>
      </article>
      <article class="vv-deal-card vv-deal-card-primary">
        <div class="vv-deal-body">
          <h3>{t('deals.direct.title')}</h3>
          <p>{t('deals.direct.body')}</p>
          <a class="btn-outline-light" href={bookingHref}>{t('deals.cta')}</a>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- DINING -->
<section class="vv-section">
  <div class="vv-container">
    <div class="vv-text-center vv-section-head">
      <p class="eyebrow">{t('dining.eyebrow')}</p>
      <h2 class="section-h2">{t('dining.title')}</h2>
      <div class="vv-divider-gold-center"></div>
      <p class="section-lead vv-mx-auto">{t('dining.lead')}</p>
    </div>
    <div class="vv-dining-grid">
      {restaurants.map(([name, cuisine, phone, rating]) => (
        <div class="vv-dining-card">
          <h4>{p(name)}</h4>
          <p class="vv-dining-cuisine">{p(cuisine)}</p>
          {rating > 0 && (
            <p class="vv-dining-rating">★ {rating}</p>
          )}
          {phone && (
            <a class="vv-dining-phone" href={`tel:${phone.replace(/[^0-9+]/g,'')}`}>{phone}</a>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ATTRACTIONS -->
<!-- GALLERY -->
<section id="gallery" class="vv-section vv-section-cream">
  <div class="vv-container">
    <div class="vv-text-center vv-section-head">
      <p class="eyebrow">{t('gallery.eyebrow')}</p>
      <h2 class="section-h2">{t('gallery.title')}</h2>
      <div class="vv-divider-gold-center"></div>
      <p class="section-lead vv-mx-auto">{t('gallery.lead')}</p>
    </div>
    <div class="vv-gallery-grid">
      {galleryImages.map((img, i) => (
        <button type="button" class="vv-gallery-cell" data-lightbox-idx={i} aria-label={t(img.altKey)}>
          <img src={withBase(img.src)} alt={t(img.altKey)} loading="lazy" />
        </button>
      ))}
    </div>
  </div>
  <div id="vv-lightbox" class="vv-lightbox" hidden role="dialog" aria-modal="true" aria-label="施設写真">
    <button type="button" class="vv-lightbox-close" aria-label="閉じる">×</button>
    <button type="button" class="vv-lightbox-prev" aria-label="前の写真">‹</button>
    <button type="button" class="vv-lightbox-next" aria-label="次の写真">›</button>
    <img id="vv-lightbox-img" alt="" />
  </div>
</section>

<!-- ATTRACTIONS -->
<section id="attractions" class="vv-section">
  <div class="vv-container">
    <div class="vv-text-center vv-section-head">
      <p class="eyebrow">{t('exp.eyebrow')}</p>
      <h2 class="section-h2">{t('exp.title')}</h2>
      <div class="vv-divider-gold-center"></div>
      <p class="section-lead vv-mx-auto">{t('exp.lead')}</p>
    </div>

    <h3 class="vv-sub-eyebrow">{t('exp.attractions')}</h3>
    <div class="vv-grid-3">
      {attractions.map(([name, tag, rating, img, desc]) => (
        <article class="vv-att-card">
          <img src={withBase(img)} alt={p(name)} loading="lazy" />
          <div class="vv-att-body">
            <p class="vv-att-tag">{p(tag)}</p>
            <h4>{p(name)}</h4>
            <p class="vv-att-rating">★ {rating}</p>
            <p class="vv-att-desc">{p(desc)}</p>
          </div>
        </article>
      ))}
    </div>

    <h3 class="vv-sub-eyebrow" style="margin-top: 60px;">{t('exp.beaches')}</h3>
    <div class="vv-grid-3">
      {beaches.map(([name, tag, rating, img]) => (
        <article class="vv-att-card">
          <img src={withBase(img)} alt={p(name)} loading="lazy" />
          <div class="vv-att-body">
            <p class="vv-att-tag">{p(tag)}</p>
            <h4>{p(name)}</h4>
            <p class="vv-att-rating">★ {rating}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- CHECK-IN -->
<section id="checkin" class="vv-section vv-section-dark">
  <div class="vv-container vv-text-center">
    <p class="eyebrow eyebrow-light">{t('checkin.title')}</p>
    <h2 class="section-h2 section-h2-light">{t('checkin.title')}</h2>
    <div class="vv-divider-gold-center"></div>
    <div class="vv-checkin-grid">
      <div class="vv-checkin-cell">
        <p class="vv-checkin-num">15<span>:00</span></p>
        <p class="vv-checkin-label">{t('checkin.in').split(':')[0]}</p>
      </div>
      <div class="vv-checkin-cell">
        <p class="vv-checkin-num">10<span>:00</span></p>
        <p class="vv-checkin-label">{t('checkin.out').split(':')[0]}</p>
      </div>
      <div class="vv-checkin-cell">
        <p class="vv-checkin-num">8</p>
        <p class="vv-checkin-label">{t('checkin.max').split(':')[0]}</p>
      </div>
    </div>
    <a href={guestHref} class="btn-outline-light vv-checkin-cta">{t('checkin.online')}</a>
  </div>
</section>

<!-- ACCESS -->
<section id="access" class="vv-section">
  <div class="vv-container">
    <div class="vv-text-center vv-section-head">
      <p class="eyebrow">{t('access.eyebrow')}</p>
      <h2 class="section-h2">{t('access.title')}</h2>
      <div class="vv-divider-gold-center"></div>
    </div>
    <div class="vv-access-grid">
      <div class="vv-access-info">
        <p class="vv-access-addr">{t('access.address')}</p>
        <ul>
          <li>{t('access.detail1')}</li>
          <li>{t('access.detail2')}</li>
          <li>{t('access.detail3')}</li>
        </ul>
        <p><a class="vv-access-tel" href="tel:+81988942474">{t('access.tel')}</a></p>
        <a href="https://www.google.com/maps/search/?api=1&query=26.162946,127.7936485" target="_blank" rel="noopener noreferrer" class="btn-outline">{t('access.map')}</a>
      </div>
      <div class="vv-access-map">
        <iframe
          src="https://maps.google.com/maps?q=26.162946,127.7936485&z=15&hl=ja&output=embed"
          title="VILLA VIEW Map"
          width="100%"
          height="380"
          style="border: 0; border-radius: 12px;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .vv-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .vv-section {
    padding: clamp(60px, 10vw, 120px) clamp(20px, 5vw, 60px);
  }
  .vv-section-cream { background: var(--color-cream-dark); }
  .vv-section-dark {
    background: var(--color-primary-darker);
    color: #fff;
  }
  .vv-text-center { text-align: center; }
  .vv-mx-auto { margin-left: auto; margin-right: auto; }
  .vv-section-head { margin-bottom: clamp(40px, 6vw, 70px); }

  .vv-divider-gold-center {
    width: 48px;
    height: 1px;
    background: var(--color-accent);
    margin: 18px auto;
  }

  /* ── 2番ブロック「この宿について」：左揃え＋写真の背景（2026-08-17 アキラさん指示）──
     背景は「アートボード 1.jpg」を上6%・下25%でトリミングしたもの。
     スクロールに合わせて写真がゆっくり下へ送られ、下のほうが見えてくる。 */
  /* 旧CONCEPTの背景写真・紙白の覆い・パララックスは 2026-09-04 に撤去した。
     Experience と同じ「左に写真・右に文章」の形へ組み替えたため不要になった。
     日本語の見出しだけ、英字見出しと本文のあいだに置くのでここで整える。 */
  .vv-concept-title {
    font-family: var(--font-serif);
    font-size: clamp(20px, 1.9vw, 26px);
    font-weight: 300;
    line-height: 1.5;
    letter-spacing: 0.06em;
    color: var(--color-ink, #2c3a31);
    white-space: pre-line;
    margin: 0 0 18px;
  }
  /* .vv-divider-gold-left（旧CONCEPTの金の横線）は 2026-09-04 に撤去。
     使っていたのは旧CONCEPTの1箇所だけで、そこを組み替えたため未使用になった。 */
  .eyebrow-light {
    color: rgba(255,255,255,0.8);
  }
  .section-h2-light {
    color: #fff;
  }
  .vv-sub-eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--color-primary);
    text-align: center;
    margin: 32px 0 24px;
  }

  /* HERO */
  .vv-hero {
    position: relative;
    /* 上下を7%ずつ詰めて、空いた14%を直下の予約ブロックに使う（2026-08-29 アキラさん指示） */
    height: 86vh;
    min-height: 520px;
    overflow: hidden;
    color: #fff;
  }
  /* ── ヒーロー直下の予約ブロック ──────────────────
     ヒーローを上下7%ずつ詰めて空けた14%に収める。 */
  .vv-bookbar {
    background: var(--color-surface, #efece4);
    border-bottom: 1px solid rgba(0,0,0,0.06);
  }
  .vv-bookbar-inner {
    max-width: 1400px;
    margin: 0 auto;
    /* 2026-09-03 アキラさん指示：ブロック全体を中央に置く。
       以前は右下の固定予約ボタン（150px）を避けるため右だけ160px余分に空けていたが、
       それが「少し左に寄って見える」原因だった。左右を同じ余白に戻し、
       中身を justify-content: center でまとめて中央に置く。
       固定ボタンとの重なりは、中央寄せで右端が空くので起きない（各幅で実測）。 */
    padding: 18px clamp(20px, 4vw, 36px);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: clamp(12px, 2vw, 28px);
    flex-wrap: wrap;
  }
  .vv-bookbar-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    /* 「日程未定」が増えて5列になったので、日付欄は伸びすぎないようにする。
       伸びしろはボタンに残す（はみ出させない）。 */
    flex: 1 1 150px;
    min-width: 130px;
    max-width: 230px;
  }
  .vv-bookbar-field label {
    font-family: var(--font-sans);
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--color-muted, #78716C);
  }
  .vv-bookbar-field input,
  .vv-bookbar-field select {
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--color-ink, #2c3a31);
    background: #fff;
    border: 1px solid rgba(0,0,0,0.14);
    border-radius: 2px;
    padding: 10px 12px;
    width: 100%;
  }
  .vv-bookbar-field input:focus-visible,
  .vv-bookbar-field select:focus-visible {
    outline: 2px solid var(--color-primary, #2a5a6e);
    outline-offset: 1px;
  }
  .vv-bookbar-guests { flex: 0 0 110px; min-width: 96px; }
  /* 日程が決まっていない人向け。チェックすると日付を送らず、
     押した先の空室カレンダーで選んでもらう。 */
  .vv-bookbar-flex {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 7px;
    padding-bottom: 11px;
  }
  .vv-bookbar-flex input { width: 16px; height: 16px; accent-color: var(--color-primary-darker, #0c1e26); }
  .vv-bookbar-flex label {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-ink, #2c3a31);
    cursor: pointer;
    white-space: nowrap;
  }
  /* 日程未定にしたとき、日付欄は残したまま操作できないことが分かるようにする */
  .vv-bookbar-field.is-off { opacity: 0.42; }
  .vv-bookbar-field.is-off input { pointer-events: none; background: #f3f1ec; }
  .vv-bookbar-submit {
    flex: 0 1 auto;
    /* 2026-09-03 アキラさん指示：margin-left:auto をやめる。
       これがボタンを右端まで飛ばし、「人数」との間に謎の空間を作っていた。
       外すと人数のすぐ隣に並ぶ。 */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 150px;
    padding: 13px clamp(18px, 2.4vw, 30px);
    background: var(--color-primary-darker, #0c1e26);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 15px;
    letter-spacing: 3px;
    text-decoration: none;
    border-radius: 2px;
    transition: background 0.3s ease;
  }
  .vv-bookbar-submit:hover { background: var(--color-primary, #2a5a6e); }
  .vv-bookbar-submit:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  @media (max-width: 700px) {
    /* 狭い画面は折り返すので、右下ボタンとぶつからない */
    .vv-bookbar-inner { gap: 12px; padding-bottom: 78px; }
    .vv-bookbar-submit { flex: 1 1 100%; }
  }

  .vv-hero-slides {
    position: absolute;
    inset: 0;
  }
  .vv-hero-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 3s ease;
    will-change: opacity;
  }
  .vv-hero-media.active { opacity: 1; }
  /* Photos only: a very slow, very slight push-in. Videos already move on their own. */
  .vv-hero-img {
    transform: scale(1);
    transform-origin: 50% 50%;
    transition: opacity 3s ease, transform 9s linear;
  }
  .vv-hero-img.vv-hero-zoom { transform: scale(1.18); }
  /* Used for one frame to snap the scale back without animating it */
  .vv-hero-media.vv-hero-noanim { transition: none; }
  /* 縦長の画面に横長写真を cover で入れると、天井と床という何も写っていない帯が
     画面の4割を占め、海やバーが中央の細い帯に潰れる。少し寄せて主題を大きく見せる。 */
  @media (max-width: 768px) {
    .vv-hero-img { transform: scale(1.28); }
    .vv-hero-img.vv-hero-zoom { transform: scale(1.46); }
    .vv-hero-video { transform: scale(1.14); }
  }
  @media (prefers-reduced-motion: reduce) {
    .vv-hero-media { transition: none; }
    .vv-hero-img,
    .vv-hero-img.vv-hero-zoom { transform: none; transition: none; }
  }
  .vv-hero-overlay {
    position: absolute;
    inset: 0;
    /* 全面を一律に暗くすると室内写真の深緑と木目が沈む。
       ヘッダーとCTAの周りだけ締めて、写真が見える帯は薄く抜く。 */
    background:
      /* 文字の背後だけを楕円で締める。7枚のうち一番明るいドローン映像でも読めるように。 */
      radial-gradient(ellipse 78% 58% at 50% 47%,
        rgba(6, 20, 28, 0.58) 0%,
        rgba(6, 20, 28, 0.34) 48%,
        rgba(6, 20, 28, 0.00) 100%),
      /* 上端はヘッダーの白文字、下端はCTAの座りを守るためだけに締める */
      linear-gradient(to bottom,
        rgba(8, 26, 34, 0.52) 0%,
        rgba(8, 26, 34, 0.14) 22%,
        rgba(8, 26, 34, 0.14) 72%,
        rgba(8, 26, 34, 0.50) 100%);
  }
  .vv-hero-content {
    position: relative;
    z-index: 2;
    /* 膜を薄くしたので、文字の影で背景から浮かせて可読性を保つ */
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.60), 0 2px 18px rgba(0, 0, 0, 0.45);
    height: 100%;
    display: flex;
    flex-direction: column;
    /* 2026-09-03 アキラさん指示：見出しはヒーローの「右下」へ。
       線画がその上に乗る形にするため、下寄せ＋右寄せにする。 */
    justify-content: flex-end;
    align-items: flex-end;
    text-align: right;
    /* 2026-09-03 アキラさん指示：英字（PRIVATE VILLA IN NANJO, OKINAWA）を
       いちばん下＝背景のすぐ上に置くので、下の余白を詰める。 */
    padding: 0 clamp(20px, 4vw, 56px) 16px;
  }
  /* 🔴 右下の3点（線画・見出し・英字）は横幅を揃える。
     基準＝英字の自然な幅（1440pxで実測402px）。この1つの変数で3つとも動く。 */
  .vv-hero-content {
    /* 2026-09-03 アキラさん指示：スマホは全体的に少し小さく（86vw → 78vw）。
       375pxで 323px → 292px。線画・見出し・クチコミ・英字が一緒に縮む。 */
    --hero-w: min(402px, 78vw);
  }
  .vv-hero-illust,
  .vv-hero-title,
  .vv-hero-rating,
  .vv-hero-eyebrow {
    width: var(--hero-w);
  }
  /* ── ヒーロー右下の線画（見出しの上に乗る）────────────
     白線・透過PNG。写真の上でも輪郭が残るよう軽く影を落とす。 */
  .vv-hero-illust {
    display: block;
    /* 幅は上の --hero-w で決まる（英字と同じ402px）。460pxから少し小さくなる。 */
    height: auto;
    margin: 0 0 8px;
    opacity: 0.92;
    filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.45));
    animation: fade-up 1s ease 0.4s both;
    pointer-events: none;
  }
  .vv-hero-eyebrow {
    font-family: var(--font-sans);
    /* 1440pxで従来どおり 11px / 字間6px。狭い画面では折り返さず比率で縮む
       （折り返すと線画・見出しと幅が揃わなくなるため）。 */
    font-size: calc(var(--hero-w) * 0.02736);
    letter-spacing: calc(var(--hero-w) * 0.01493);
    white-space: nowrap;
    text-transform: uppercase;
    opacity: 0.85;
    /* 2026-09-03 アキラさん指示：英字は線画の上。さらに「今の位置と、絵の中の鳥の
       中間くらい」まで下げる。鳥は画像の上から26.4%（canvasで実測）＝表示高226pxなら
       上から約60px。従来は絵の14px上だったので、中間＝絵の上から約23px下。
       負の余白で絵に重ねる（絵の上部は透過の空なので重なっても絵は隠れない）。 */
    margin: 0 0 calc(var(--hero-w) * -0.057);
    position: relative;
    z-index: 1;
    animation: fade-up 1s ease 0.3s both;
  }
  .vv-hero-title {
    font-family: var(--font-serif);
    /* 2026-09-03 アキラさん指示：横幅が線画・英字と同じになる大きさにする。
       8文字 ×（字送り＋字間）＝ --hero-w になるよう比率で出す（402px → 48px）。 */
    /* 2026-09-03 アキラさん指示：字間と行間を少し広げ、そのぶん文字を小さくして
       横幅は --hero-w のまま保つ。8文字 ×（文字＋字間）＝ --hero-w になる比率。
       字間 0.005→0.00995（402pxで2.0px→4.0px）／文字 0.1194→0.11505（48px→46.25px）
       ＝ 8 ×（46.25 + 4.0）＝ 402px で幅は変わらない。 */
    font-size: calc(var(--hero-w) * 0.11505);
    font-weight: 300;
    line-height: 1.5;
    letter-spacing: calc(var(--hero-w) * 0.00995);
    margin: 0 0 12px;
    white-space: pre-line;
    animation: fade-up 1s ease 0.5s both;
  }
  /* .vv-hero-divider（見出し下の短い横線）は 2026-09-03 アキラさん指示で削除。
     マークアップからも外したので、CSSもここで消している。 */
  .vv-hero-lead {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    opacity: 1;
    max-width: 560px;
    line-height: 1.8;
    margin: 0 0 36px;
    animation: fade-up 1s ease 0.9s both;
  }
  .vv-hero-cta {
    display: inline-block;
    padding: 18px 48px;
    background: linear-gradient(135deg, #1d6cd0 0%, #0a4a99 100%);
    color: #fff;
    border: 0;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 2px;
    text-decoration: none;
    box-shadow: 0 8px 28px rgba(13, 71, 161, 0.45),
                0 2px 6px rgba(0, 0, 0, 0.18),
                inset 0 1px 0 rgba(255, 255, 255, 0.18);
    transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
    animation: fade-up 1s ease 1.1s both, vv-hero-cta-pulse 2.6s ease-in-out 2.2s infinite;
    position: relative;
    overflow: hidden;
  }
  .vv-hero-cta::before {
    content: '';
    position: absolute;
    top: 0; left: -75%;
    width: 50%; height: 100%;
    background: linear-gradient(120deg, transparent 0%, rgba(255,255,255,0.35) 50%, transparent 100%);
    transform: skewX(-20deg);
    animation: vv-hero-cta-shine 3.4s ease-in-out 3s infinite;
    pointer-events: none;
  }
  .vv-hero-cta:hover {
    background: linear-gradient(135deg, #2680e5 0%, #0b56b0 100%);
    transform: translateY(-2px);
    box-shadow: 0 12px 36px rgba(13, 71, 161, 0.55),
                0 4px 10px rgba(0, 0, 0, 0.22),
                inset 0 1px 0 rgba(255, 255, 255, 0.22);
  }
  .vv-hero-cta:active { transform: translateY(0); }
  @keyframes vv-hero-cta-pulse {
    0%, 100% { box-shadow: 0 8px 28px rgba(13, 71, 161, 0.45), 0 2px 6px rgba(0,0,0,0.18), inset 0 1px 0 rgba(255,255,255,0.18); }
    50%      { box-shadow: 0 10px 36px rgba(29, 108, 208, 0.65), 0 2px 6px rgba(0,0,0,0.18), inset 0 1px 0 rgba(255,255,255,0.22); }
  }
  @keyframes vv-hero-cta-shine {
    0%   { left: -75%; }
    60%  { left: 125%; }
    100% { left: 125%; }
  }
  .vv-hero-rating {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 2px;
    /* クチコミ 9.4/10 は成約材料。読めない濃さにしない */
    opacity: 0.88;
    margin: 0;
    animation: fade-up 1s ease 1.3s both;
  }

  /* ── EXPERIENCE ─────────────────────────────────
     るうふ杉之家の実測値（1280px幅）を基準にした：
       見出し 120px／cormorant-garamond／weight 100／色 #969BA0
       左の写真 759×554／右のリード 縦書き・A1明朝19.5px・行間2.0・幅273×高さ448
     A1明朝は有料フォントで持っていないので、サイト既定の明朝（Shippori Mincho）を当てる。 */
  .vv-exp {
    padding: clamp(64px, 9vw, 120px) 0;
    background: var(--color-bg, #fff);
  }
  .vv-exp-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 36px);
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: start;
  }
  /* 写真＝アキラさんがトリミングして支給した版（2026-09-03 17:24・1157×748）。
     元 HP掲載１.png 1.3MB を拡大せずJPEG化して233KBに。
     🔴 トリミングは既に画像側で済んでいるので、CSSでは切らない。
     枠の縦横比を画像と同じ 1157/748 にしてあるため `object-fit: cover` は
     実質なにも削らない（保険としてだけ置いている）。
     ここで別の縦横比を指定すると、切られた画像をさらに切ることになる。 */
  .vv-exp-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1157 / 748;
    object-fit: cover;
    /* 2026-09-03 アキラさん指示：少しだけ右へ。
       transform なので大きさも列の幅も変わらず、右の文章との間隔だけが詰まる。
       間隔は clamp(24px,4vw,64px) あるので、この移動量なら文章に触れない（実測で確認）。 */
    transform: translateX(clamp(12px, 2.2vw, 32px));
  }
  .vv-exp-text {
    display: flex;
    flex-direction: column;
    /* 横書きにしたので、リードは列いっぱいに広げる（flex-start だと内容幅に縮む） */
    align-items: stretch;
  }
  .vv-exp-heading {
    font-family: "Cormorant Garamond", var(--font-serif), serif;
    font-size: clamp(56px, 8.4vw, 120px);
    /* るうふは weight 100 だが、当サイトが読み込んでいる Cormorant Garamond は
       300 が最軽量（global.css の @import）。無い太さを指定すると偽の細字になるので 300 にする。 */
    font-weight: 300;
    line-height: 1;
    color: #969BA0;
    margin: 0 0 clamp(20px, 3vw, 40px);
    /* 左の写真の上端と頭を揃えるため、明朝の字面ぶんだけ持ち上げる */
    margin-top: -0.12em;
  }
  /* 2026-09-03 アキラさん指示：リード文は縦書きをやめて横書きにする。
     （るうふは縦書きだが、当サイトは横書きで通す判断） */
  .vv-exp-lead {
    font-family: var(--font-serif);
    /* 2026-09-03 アキラさん指示：本文をもう少し大きく（17 → 19px） */
    font-size: clamp(16px, 1.4vw, 19px);
    font-weight: 400;
    line-height: 2;
    letter-spacing: 0.02em;
    color: var(--color-ink, #2c3a31);
    margin: 0;
  }
  @media (max-width: 900px) {
    .vv-exp-inner {
      grid-template-columns: 1fr;
      gap: clamp(20px, 5vw, 36px);
    }
    .vv-exp-text {
      flex-direction: column;
      align-items: stretch;
      gap: clamp(16px, 4vw, 28px);
    }
    .vv-exp-heading { margin: 0; }
    /* 狭い画面の文字サイズは、るうふ実測（390px幅で16.64px／行間2.0）に合わせる */
    .vv-exp-lead { font-size: clamp(15px, 4.3vw, 16.6px); }
    /* 🔴 写真の右シフトは「左に写真・右に文章」の並びのときだけ意味がある。
       積み重なる幅では写真が全幅になるので、右へずらすと左右の余白が
       不揃いになる（実測：390px幅で左32px・右8px）。ここでは解除する。 */
    .vv-exp-photo { transform: none; }
  }

  /* Grids */
  .vv-grid-3 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }
  .vv-grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
  }

  /* Facility card */
  .vv-fac-card {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--color-cream-darker);
    transition: transform 0.4s, box-shadow 0.4s;
  }
  .vv-fac-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0,0,0,0.08);
  }
  .vv-fac-img-wrap {
    height: 220px;
    overflow: hidden;
  }
  .vv-fac-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .vv-fac-card:hover .vv-fac-img-wrap img { transform: scale(1.05); }
  .vv-fac-body { padding: 22px 24px; }
  .vv-fac-body h3 {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 400;
    margin: 0 0 8px;
    color: var(--color-ink);
  }
  .vv-fac-body p {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--color-muted);
    line-height: 1.7;
    margin: 0;
  }

  /* Deal card */
  .vv-deal-card {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--color-cream-darker);
    display: flex;
    flex-direction: column;
  }
  .vv-deal-card img {
    width: 100%;
    height: 240px;
    object-fit: cover;
  }
  .vv-deal-body { padding: 28px 30px; }
  .vv-deal-body h3 {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 400;
    margin: 0 0 10px;
  }
  .vv-deal-body p {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--color-muted);
    line-height: 1.7;
    margin: 0 0 18px;
  }
  .vv-deal-card-primary {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: #fff;
