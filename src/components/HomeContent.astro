<script>
  // 2026-09-03：予約ブロックを中央寄せにしたので、右下の固定「予約する」ボタンが
  // 「空室を見る」に重なるようになった（1100px・900pxで実測）。
  // 以前は予約ブロックの右に160pxの余白を空けて避けていたが、それが
  // 「少し左に寄って見える」原因だったため撤去した。
  // 代わりに、予約ブロック自体が画面に見えている間は固定ボタンを引っ込める。
  // 本物の入力欄が目の前にあるとき、同じ行き先のボタンを重ねて出す意味がないため。
  {
    const bar = document.querySelector('.vv-bookbar');
    const fix = document.querySelector('.vv-fix-book');
    if (bar && fix) {
      // 固定ボタンが居座るのは画面右下の帯。予約ブロックがその帯にかかっている間だけ隠す。
      const BAND = 80; // 固定ボタンの高さ65px＋余裕
      const update = () => {
        const r = bar.getBoundingClientRect();
        const inBand = r.bottom > window.innerHeight - BAND && r.top < window.innerHeight;
        fix.classList.toggle('is-tucked', inBand);
      };
      // 1要素の getBoundingClientRect だけなので、間引かず直接呼んで問題ない。
      // （requestAnimationFrame で間引くと、裏に回ったタブで更新が止まる）
      addEventListener('scroll', update, { passive: true });
      addEventListener('resize', update);
      update();
    }
  }
</script>

<script>
  // 予約ブロックの入力を Beds24 のURLに載せる。
  // Beds24 が受けるのは checkin（YYYY-MM-DD）／numnight（泊数）／numadult（人数）。
  {
    const inEl  = document.getElementById('vv-bb-in');
    const outEl = document.getElementById('vv-bb-out');
    const gEl   = document.getElementById('vv-bb-guests');
    const go    = document.getElementById('vv-bb-go');

    if (inEl && outEl && gEl && go) {
      const base = go.getAttribute('href');
      const iso = (d) => d.toISOString().slice(0, 10);

      // 既定値＝明日から1泊。日付が未入力のままでも予約ページが開けるようにする。
      const t = new Date(); t.setDate(t.getDate() + 1);
      const t2 = new Date(t); t2.setDate(t2.getDate() + 1);
      inEl.value  = iso(t);
      outEl.value = iso(t2);
      inEl.min = iso(new Date());

      const flexEl = document.getElementById('vv-bb-flex');

      const sync = () => {
        // 日程未定にチェックが入っていたら、日付を送らずに空室カレンダーへ送る
        const flexible = flexEl && flexEl.checked;
        inEl.closest('.vv-bookbar-field').classList.toggle('is-off', flexible);
        outEl.closest('.vv-bookbar-field').classList.toggle('is-off', flexible);
        if (flexible) {
          const u = new URL(base);
          u.searchParams.delete('checkin');
          u.searchParams.delete('numnight');
          u.searchParams.set('numadult', gEl.value);
          go.setAttribute('href', u.toString());
          return;
        }
        const ci = inEl.value;
        const co = outEl.value;
        let nights = 1;
        if (ci && co) {
          const diff = (new Date(co) - new Date(ci)) / 86400000;
          if (diff >= 1) nights = Math.round(diff);
        }
        // チェックアウトはチェックイン翌日以降にしか選べないようにする
        if (ci) {
          const min = new Date(ci); min.setDate(min.getDate() + 1);
          outEl.min = iso(min);
          if (co && new Date(co) <= new Date(ci)) outEl.value = iso(min);
        }
        const url = new URL(base);
        url.searchParams.set('checkin', ci);
        url.searchParams.set('numnight', String(nights));
        url.searchParams.set('numadult', gEl.value);
        go.setAttribute('href', url.toString());
      };

      if (flexEl) flexEl.addEventListener('change', sync);
      inEl.addEventListener('change', sync);
      outEl.addEventListener('change', sync);
      gEl.addEventListener('change', sync);
      sync();
    }
  }
</script>

