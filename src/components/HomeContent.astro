---
import { getLangFromPath, useT, localizedPath, withBase } from '../i18n/utils';

const lang = getLangFromPath(Astro.url.pathname);
const t = useT(lang);

// Pick row by lang: 0=en, 1=ja, 2=zh, otherwise fall back to en
const pickIdx = (() => {
  if (lang === 'ja') return 1;
  if (lang === 'zh' || lang === 'zh-Hant') return 2;
  return 0;
})();
const p = (s: string) => s.split('|')[pickIdx] ?? s.split('|')[0];

// Hero slides: photos hold for 5s, videos play through at their natural length
// (durationFallback is only used when video.duration cannot be read).
type HeroSlide = {
  src: string;
  type: 'image' | 'video';
  poster?: string;
  durationFallback?: number;
  // 尺の短いクリップ用の追い足し時間。クリップが終わったあと、この分だけ
  // 最後のコマのまま残ってから溶け始める（フェード中なので静止には見えない）。
  extraHoldMs?: number;
};
const heroSlides: HeroSlide[] = [
  { src: '/images/hero-bedroom.jpg', type: 'image' },
  { src: '/images/hero-drone-1.mp4', type: 'video', poster: '/images/hero-drone-1-poster.jpg', durationFallback: 7.1 },
  { src: '/images/hero-bar.jpg',     type: 'image' },
  { src: '/images/hero-cafe.jpg',    type: 'image' },
  { src: '/images/hero-drone-2.mp4', type: 'video', poster: '/images/hero-drone-2-poster.jpg', durationFallback: 5.8, extraHoldMs: 1800 },
  { src: '/images/hero-hall.jpg',    type: 'image' },
  { src: '/images/night-view.jpg',   type: 'image' },
];

const facilities = [
  { img: '/images/guestroom/bedroom-oceanview.jpg', titleKey: 'facility.room.title',    descKey: 'facility.room.desc' },
  { img: '/images/coffee/coffeearea2.jpg',           titleKey: 'facility.coffee.title',  descKey: 'facility.coffee.desc' },
  { img: '/images/yogastudio/IMG_4715.jpg',          titleKey: 'facility.yoga.title',    descKey: 'facility.yoga.desc' },
  { img: '/images/bbq/IMG_7211.jpg',                 titleKey: 'facility.bbq.title',     descKey: 'facility.bbq.desc' },
  { img: '/images/therapy/IMG_5915.jpg',             titleKey: 'facility.therapy.title', descKey: 'facility.therapy.desc' },
  { img: '/images/guestroom/terrace.jpg',            titleKey: 'facility.minibar.title', descKey: 'facility.minibar.desc' },
];

const galleryImages: { src: string; altKey: string }[] = [
  { src: '/images/guestroom/guestroom-oceanview.jpg',    altKey: 'photo.bedroomSea' },
  { src: '/images/guestroom/bedroom-oceanview.jpg',      altKey: 'photo.bedroom' },
  { src: '/images/guestroom/living-room.jpg',            altKey: 'photo.living' },
  { src: '/images/guestroom/terrace.jpg',                altKey: 'photo.terrace' },
  { src: '/images/guestroom/washitu.jpg',                altKey: 'photo.washitsu' },
  { src: '/images/yogastudio/living-room-oceanview.jpg', altKey: 'photo.hallSea' },
  { src: '/images/yogastudio/IMG_4715.jpg',              altKey: 'photo.hall' },
  { src: '/images/yogastudio/bancony.jpg',               altKey: 'photo.balcony' },
  { src: '/images/bbq/IMG_7211.jpg',                     altKey: 'photo.bbq' },
  { src: '/images/coffee/coffeearea2.jpg',               altKey: 'photo.desk' },
  { src: '/images/therapy/IMG_5915.jpg',                 altKey: 'photo.sauna' },
  { src: '/images/minibar/ballparty.jpg',                altKey: 'photo.hallParty' },
];

// 間取りブロック（2026-09-18 新設 / 同日 図面と写真を差し替え）
// 図面は1F・2Fを別画像に切り出したものを使う（785×702 / 421×546）。
// 座標は「その階の画像」に対する % で持つ。1F のピンは1F画像、2F のピンは2F画像が基準。
// side＝ラベルチップを出す向き。図に焼き込まれた英字（Hall / CAFE area / Balcony /
// Terrace BBQ area / Bathroom / W.C.）を覆わない向きを1件ずつ選んである。
// group＝ライトボックスの群。部屋ごとに分けてあるので、前後送りはその部屋の中だけで回る。
type FloorRoom = {
  n: number; floor: 1 | 2; x: number; y: number;
  group: string; photos: string[]; labelKey: string; capKey: string;
  beds: ('d' | 's' | 'sofa' | 'futon')[];
};
const FM = '/images/floormap/';
// 番号は図の中で上から下へ自然に並ぶ順。1F が①〜⑧、2F が⑨〜⑪。
// 図の上に出すのは番号バッジだけ（2026-09-18 アキラさん指示で部屋名のチップは廃止）。
// 部屋名は図の下の番号つきリストで読む。
const floorRooms: FloorRoom[] = [
  { n: 1,  floor: 1, x: 62.0, y: 24.9, group: 'floor-cafe',     photos: ['cafe-1.jpg'],                                         labelKey: 'floor.room.cafe',     capKey: 'floor.cap.cafe',     beds: [] },
  { n: 2,  floor: 1, x: 76.2, y: 42.7, group: 'floor-hall',     photos: ['hall-1.jpg', 'hall-2.jpg', 'hall-3.jpg'],             labelKey: 'floor.room.hall',     capKey: 'floor.cap.hall',     beds: [] },
  // 風呂場とホールの間の小部屋＝セラピールーム。1人用サウナドームを置いている（Airbnb本文の表記に合わせる）
  { n: 3,  floor: 1, x: 53.9, y: 54.0, group: 'floor-sauna',    photos: ['sauna-1.jpg', 'sauna-2.jpg'],                         labelKey: 'floor.room.sauna',    capKey: 'floor.cap.sauna',    beds: [] },
  { n: 4,  floor: 1, x: 28.7, y: 55.6, group: 'floor-washitsu', photos: ['washitsu-1.jpg', 'washitsu-2.jpg', 'washitsu-3.jpg'], labelKey: 'floor.room.washitsu', capKey: 'floor.cap.washitsu', beds: ['futon', 'futon', 'futon'] },
  { n: 5,  floor: 1, x: 87.9, y: 61.3, group: 'floor-balcony',  photos: ['terrace-1.jpg'],                                      labelKey: 'floor.room.balcony',  capKey: 'floor.cap.balcony',  beds: [] },
  { n: 6,  floor: 1, x: 14.0, y: 78.5, group: 'floor-terrace',  photos: ['balcony-1.jpg', 'balcony-2.jpg'],                     labelKey: 'floor.room.terrace',  capKey: 'floor.cap.terrace',  beds: [] },
  { n: 7,  floor: 1, x: 29.5, y: 76.5, group: 'floor-living',   photos: ['living-1.jpg', 'living-2.jpg'],                       labelKey: 'floor.room.living',   capKey: 'floor.cap.living',   beds: [] },
  { n: 8,  floor: 1, x: 48.0, y: 79.3, group: 'floor-dining',   photos: ['dining-1.jpg', 'dining-2.jpg'],                       labelKey: 'floor.room.dining',   capKey: 'floor.cap.dining',   beds: [] },
  // bedroom1＝2F右上・シングル2
  { n: 9,  floor: 2, x: 65.3, y: 45.8, group: 'floor-bedB',     photos: ['bed1-1.jpg', 'bed1-2.jpg', 'bed1-3.jpg'],             labelKey: 'floor.room.bedB',     capKey: 'floor.cap.bedB',     beds: ['s', 's'] },
  // bedroom2＝2F右下・ダブル＋ソファベッド
  { n: 10, floor: 2, x: 68.9, y: 66.0, group: 'floor-bedA',     photos: ['bed2-1.jpg', 'bed2-2.jpg', 'bed2-3.jpg', 'bed2-4.jpg'], labelKey: 'floor.room.bedA',   capKey: 'floor.cap.bedA',     beds: ['d', 'sofa'] },
  // bedroom3＝2F左下・シングル2
  { n: 11, floor: 2, x: 23.8, y: 85.7, group: 'floor-bedC',     photos: ['bed3-1.jpg', 'bed3-2.jpg'],                           labelKey: 'floor.room.bedC',     capKey: 'floor.cap.bedC',     beds: ['s', 's'] },
];

const restaurants: [string, string, string, number][] = [
  ['CAFE&BAR GarageLife|カフェ＆バー ガレージライフ|GarageLife', 'American · Burgers|アメリカン・バーガー|美式汉堡', '+81 80-3998-5885', 4.7],
  ['Okinawa Soba Maruchi|沖縄そば まるち|冲绳荞麦 Maruchi', 'Okinawa Soba|沖縄そば|冲绳荞麦面', '+81 98-917-5850', 4.4],
  ['Laurel|ローレル|Laurel 墨西哥', 'Mexican · Tacos|メキシカン・タコス|墨西哥菜·塔可', '+81 98-917-6084', 4.8],
  ['Kakinohana Soba|柿の花そば|柿花荞麦面', 'Japanese · Soba|沖縄そば|日式荞麦面', '+81 70-8506-0238', 4.6],
  ['modica|モディカ|modica 巧克力', 'Chocolate · Coffee|チョコレート・コーヒー|巧克力·咖啡', '+81 80-6494-7309', 4.6],
  ['France Shokudo 1663|フランス食堂1663|法式食堂1663', 'French · Italian|フレンチ・イタリアン|法式·意式', '', 0],
];

const attractions: [string, string, number, string, string][] = [
  ['Sefa Utaki|斎場御嶽|斋场御嶽', 'UNESCO Heritage|世界遺産|世界遗产', 4.3, '/images/attractions/sefa-utaki.jpg', 'Most sacred Ryukyu site.|琉球最高聖地。|琉球最神圣之地。'],
  ['Nanjo Museum|南城美術館|南城美术馆', 'Contemporary Art|現代アート|当代艺术', 4.2, '/images/attractions/nanjo-museum.jpg', 'Hilltop art museum with ocean views.|丘の上の美術館。海景。|山丘上的美术馆，海景。'],
  ['Gyokusendo Cave|玉泉洞|玉泉洞', 'Natural Wonder|自然の驚異|自然奇观', 4.4, '/images/attractions/gyokusendo.jpg', "One of Japan's largest limestone caves.|日本最大級鍾乳洞。|日本最大石灰岩洞。"],
  ['Valley of Gangala|ガンガラーの谷|Gangala山谷', 'Guided Tour|ガイドツアー|自然导览', 4.4, '/images/attractions/gangala.jpg', 'Mystical valley with ancient caves.|神秘の谷。|远古洞穴森林。'],
  ['Cape Chinen Park|知念岬公園|知念岬公园', 'Scenic Viewpoint|絶景スポット|绝美观景', 4.4, '/images/attractions/chinen-cape.jpg', 'Best sunrise spot in Okinawa.|沖縄屈指の日の出スポット。|冲绳最佳日出观景点。'],
  ['Nirai Kanai Bridge|ニライカナイ橋|Nirai Kanai大桥', 'Scenic Drive|絶景ドライブ|绝美兜风', 4.4, '/images/attractions/niraikanai.jpg', 'S-curve bridge descending toward the ocean.|海に向かうS字カーブ。|通往大海的S形弯桥。'],
];

const beaches: [string, string, number, string][] = [
  ['Kudaka Island|久高島|久高岛', 'Sacred Island|神の島|神之岛', 4.6, '/images/attractions/kudaka-ferry.jpg'],
  ['Ojima Island|奥武島|奥武岛', 'Cat Island|猫の島|猫之岛', 4.4, '/images/attractions/ojima.jpg'],
  ['Mibaru Beach|みーばるビーチ|美巴鲁海滩', 'Natural Beach|天然ビーチ|天然海滩', 4.2, '/images/attractions/mibaru.jpg'],
  ['Hyakuna Beach|百名ビーチ|百名海滩', 'Secluded|穴場|私密海滩', 4.3, '/images/attractions/hyakuna-beach.jpg'],
  ['Azama Sun Sun Beach|あざまサンサンビーチ|安座真阳光海滩', 'Family Beach|ファミリー|家庭海滩', 4.1, '/images/attractions/azama.jpg'],
];

const beds24LangMap: Record<string, string> = {
  'zh-Hant': 'zh-Hant', ja: 'ja', en: 'en', zh: 'zh',
  ko: 'ko', th: 'th', hi: 'hi', fr: 'fr', de: 'de', es: 'es',
};
const bookingHref = `https://beds24.com/booking2.php?propid=322452&lang=${beds24LangMap[lang] ?? 'ja'}&numnight=1`;
const guestHref = localizedPath('/guest-service/', lang);
---

<!-- HERO -->
<section class="vv-hero">
  <div class="vv-hero-slides">
    {heroSlides.map((slide, i) => (
      slide.type === 'video' ? (
        <video
          src={withBase(slide.src)}
          poster={slide.poster ? withBase(slide.poster) : undefined}
          class:list={['vv-hero-media', 'vv-hero-video', i === 0 ? 'active' : '']}
          data-idx={i}
          data-duration={slide.durationFallback}
          data-extra-hold={slide.extraHoldMs}
          preload="none"
          muted
          playsinline
          aria-hidden="true"
          tabindex="-1"
        />
      ) : (
        <img
          src={withBase(slide.src)}
          alt="VILLA VIEW Okinawa"
          class:list={['vv-hero-media', 'vv-hero-img', i === 0 ? 'active' : '']}
          data-idx={i}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'auto'}
        />
      )
    ))}
  </div>
  <div class="vv-hero-overlay"></div>
  <div class="vv-hero-content">
    <p class="vv-hero-eyebrow">{t('hero.eyebrow')}</p>
    <img
      class="vv-hero-illust"
      src={withBase('/images/hero-illust.png')}
      alt=""
      aria-hidden="true"
      width="1200"
      height="675"
      fetchpriority="high"
    />
    <h1 class="vv-hero-title">{t('hero.title')}</h1>
    <p class="vv-hero-rating">{t('hero.rating')}</p>
  </div>
</section>

<!-- BOOKING BAR：ヒーロー直下の予約ブロック（るうふ杉之家と同じ位置・同じ役割）。
     ヒーローから外したCTAはここが引き受ける。送り先は Beds24。 -->
<section class="vv-bookbar" aria-label={t('booking.heading')}>
  <div class="vv-bookbar-inner">
    <div class="vv-bookbar-field">
      <label for="vv-bb-in">{t('bookbar.checkin')}</label>
      <input type="date" id="vv-bb-in" />
    </div>
    <div class="vv-bookbar-field">
      <label for="vv-bb-out">{t('bookbar.checkout')}</label>
      <input type="date" id="vv-bb-out" />
    </div>
    <div class="vv-bookbar-flex">
      <input type="checkbox" id="vv-bb-flex" />
      <label for="vv-bb-flex">{t('bookbar.flexible')}</label>
    </div>
    <div class="vv-bookbar-field vv-bookbar-guests">
      <label for="vv-bb-guests">{t('bookbar.guests')}</label>
      <select id="vv-bb-guests">
        {[1,2,3,4,5,6,7,8].map(n => (
          <option value={n} selected={n === 4}>{n}</option>
        ))}
      </select>
    </div>
    <a href={bookingHref} class="vv-bookbar-submit" id="vv-bb-go">{t('bookbar.submit')}</a>
  </div>
</section>

<!-- EXPERIENCE：るうふ杉之家の同名ブロックを実測して移植（2026-09-03）。
     左に大判写真、右上に極細グレーの大見出し、その下に縦書きのリード文。
     リード文はアキラさん本人の確定稿（memory: project_villaview_toppage_redesign 末尾）。
     カード3枚は未設計のため、まだ置いていない。 -->
<section id="experience" class="vv-exp">
  <div class="vv-exp-inner">
    <img
      class="vv-exp-photo"
      src={withBase('/images/experience-lead.jpg')}
      alt="窓の外に海と街並みが広がるカフェスペースで、テーブルを囲む家族"
      width="1157"
      height="748"
      loading="lazy"
      decoding="async"
    />
    <div class="vv-exp-text">
      <p class="vv-exp-heading" aria-hidden="true">Experience</p>
      <h2 class="vv-exp-lead">{t('experience.lead')}</h2>
    </div>
  </div>
</section>

<!-- CONCEPT：2026-09-04 アキラさん指示で Experience の下へ移動し、
     Experience と同じ形（左に大判写真・右上に極細グレーの英字見出し・その下に本文）に
     組み替えた。トンマナを確実に揃えるため CSS は .vv-exp 系をそのまま共有している。
     「この宿について」の日本語ラベルは廃止し、英字見出し `Space` に置き換え。 -->
<section id="vv-concept-sec" class="vv-exp vv-exp--rev">
  <div class="vv-exp-inner">
    <img
      class="vv-exp-photo"
      src={withBase('/images/concept-photo.jpg')}
      alt="海に面した窓と、白いベッドが2台ならぶ寝室"
      width="1600"
      height="1066"
      loading="lazy"
      decoding="async"
    />
    <div class="vv-exp-text">
      <p class="vv-exp-heading" aria-hidden="true">Space</p>
      <h2 class="vv-concept-title">{t('concept.title')}</h2>
      <p class="vv-exp-lead">{t('concept.body')}</p>
    </div>
  </div>
</section>

<!-- FLOOR MAP（間取り）：2026-09-18 新設。設計＝CONCEPT の直後・FACILITIES の前。
     PC は 1F+2F が横に並んだ元画像を1枚のまま出し、SP は「縮小全景（形を見せる図）」＋
     「1F/2F タブで拡大した図（読む図）」の二段構えにする。クロップは画像を切らずに
     枠の中で面をずらして行うので、ピンの %座標は3つの見え方で共通に使える。 -->
<section id="floormap" class="vv-section">
  <div class="vv-container">
    <div class="vv-text-center vv-section-head">
      <p class="eyebrow">{t('floor.eyebrow')}</p>
      <h2 class="section-h2">{t('floor.title')}</h2>
      <div class="vv-divider-gold-center"></div>
      <p class="section-lead vv-mx-auto">{t('floor.lead')}</p>
    </div>

    <!-- 縮小全景：SP だけに出す。文字は読めなくてよく、建物の形と上下の関係だけを渡す。 -->
    <img
      class="vv-fm-overview"
      src={withBase('/images/floor-map.webp')}
      alt={t('floor.overviewAlt')}
      width="1298"
      height="918"
      loading="lazy"
      decoding="async"
    />

    <div class="vv-fm-tabs" role="tablist" aria-label={t('floor.eyebrow')}>
      <button type="button" class="vv-fm-tab is-on" data-fm-tab="1" role="tab" aria-selected="true">{t('floor.tab1')}</button>
      <button type="button" class="vv-fm-tab" data-fm-tab="2" role="tab" aria-selected="false">{t('floor.tab2')}</button>
    </div>

    <div class="vv-fm-stage" id="vv-fm-stage" data-fm-view="all">
      {([1, 2] as const).map(fl => (
        <figure class="vv-fm-fig" data-fm-floor={fl}>
          <img
            class="vv-fm-map"
            src={withBase(fl === 1 ? '/images/floor-1f.webp' : '/images/floor-2f.webp')}
            alt={fl === 1 ? t('floor.tab1') : t('floor.tab2')}
            width={fl === 1 ? 785 : 421}
            height={fl === 1 ? 702 : 546}
            loading="lazy"
            decoding="async"
          />
          {floorRooms.filter(r => r.floor === fl).map(r => (
            <button
              type="button"
              class="vv-fm-pin"
              style={`left:${r.x}%;top:${r.y}%`}
              data-lb-group={r.group}
              data-lb-idx="0"
              aria-label={t(r.labelKey)}
            >
              <span class="vv-fm-pin-n" aria-hidden="true">{r.n}</span>
            </button>
          ))}
        </figure>
      ))}
    </div>

    <p class="vv-fm-note">{t('floor.area')}</p>

    <ul class="vv-fm-list">
      {floorRooms.map(r => (
        <li>
          <button type="button" class="vv-fm-row" data-lb-group={r.group} data-lb-idx="0" aria-label={t(r.capKey)}>
            <span class="vv-fm-n" aria-hidden="true">{r.n}</span>
            <img class="vv-fm-thumb" src={withBase(FM + r.photos[0])} alt="" loading="lazy" decoding="async" />
            <span class="vv-fm-rowtext">
              <span class="vv-fm-name">{t(r.labelKey)}</span>
              <span class="vv-fm-floor">{r.floor === 1 ? t('floor.tab1') : t('floor.tab2')}</span>
            </span>
            <span class="vv-fm-beds" aria-hidden="true">
              {r.beds.map(b => (<i class={`vv-fm-bed vv-fm-bed--${b}`}></i>))}
            </span>
          </button>
        </li>
      ))}
    </ul>

    <div class="vv-text-center vv-fm-cta">
      <a class="btn-outline" href={bookingHref}>{t('floor.cta')}</a>
    </div>
  </div>
</section>

<!-- FACILITIES -->
<section id="facilities" class="vv-section">
  <div class="vv-container">
    <div class="vv-text-center vv-section-head">
      <p class="eyebrow">{t('facilities.eyebrow')}</p>
      <h2 class="section-h2">{t('facilities.title')}</h2>
      <div class="vv-divider-gold-center"></div>
      <p class="section-lead vv-mx-auto">{t('facilities.lead')}</p>
    </div>
    <div class="vv-grid-3">
      {facilities.map(f => (
        <article class="vv-fac-card">
          <div class="vv-fac-img-wrap">
            <img src={withBase(f.img)} alt={t(f.titleKey)} loading="lazy" />
          </div>
          <div class="vv-fac-body">
            <h3>{t(f.titleKey)}</h3>
            <p>{t(f.descKey)}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- DEALS -->
<section class="vv-section vv-section-cream">
  <div class="vv-container">
    <div class="vv-text-center vv-section-head">
      <p class="eyebrow">{t('deals.eyebrow')}</p>
      <h2 class="section-h2">{t('deals.title')}</h2>
      <div class="vv-divider-gold-center"></div>
      <p class="section-lead vv-mx-auto">{t('deals.lead')}</p>
    </div>
    <div class="vv-grid-2">
      <article class="vv-deal-card">
        <img src={withBase('/images/lawson.jpg')} alt="LAWSON" loading="lazy" />
        <div class="vv-deal-body">
          <h3>{t('deals.lawson.title')}</h3>
          <p>{t('deals.lawson.body')}</p>
        </div>
