       前後送りの並びが二重にならない。 -->
  <script type="application/json" is:inline data-lb-data="gallery" set:html={JSON.stringify(
    galleryImages.map(g => ({ src: withBase(g.src), alt: t(g.altKey) }))
  )}></script>
  {floorRooms.map(r => (
    <script type="application/json" is:inline data-lb-data={r.group} set:html={JSON.stringify(
      r.photos.map(f => ({ src: withBase(FM + f), alt: t(r.labelKey), cap: t(r.capKey), n: r.n }))
    )}></script>
  ))}
</section>

