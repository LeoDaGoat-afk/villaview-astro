<style>
  .vv-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .vv-section {
    padding: clamp(60px, 10vw, 120px) clamp(20px, 5vw, 60px);
  }
  .vv-section-cream { background: var(--color-cream-dark); }
  .vv-section-dark {
    background: var(--color-primary-darker);
    color: #fff;
  }
  .vv-text-center { text-align: center; }
  .vv-mx-auto { margin-left: auto; margin-right: auto; }
  .vv-section-head { margin-bottom: clamp(40px, 6vw, 70px); }

  .vv-divider-gold-center {
    width: 48px;
    height: 1px;
    background: var(--color-accent);
    margin: 18px auto;
  }

  /* ── 2番ブロック「この宿について」：左揃え＋写真の背景（2026-08-17 アキラさん指示）──
     背景は「アートボード 1.jpg」を上6%・下25%でトリミングしたもの。
     スクロールに合わせて写真がゆっくり下へ送られ、下のほうが見えてくる。 */
  /* 旧CONCEPTの背景写真・紙白の覆い・パララックスは 2026-09-04 に撤去した。
     Experience と同じ「左に写真・右に文章」の形へ組み替えたため不要になった。
     日本語の見出しだけ、英字見出しと本文のあいだに置くのでここで整える。 */
  .vv-concept-title {
    font-family: var(--font-serif);
    font-size: clamp(20px, 1.9vw, 26px);
    font-weight: 300;
    line-height: 1.5;
    letter-spacing: 0.06em;
    color: var(--color-ink, #2c3a31);
    white-space: pre-line;
    margin: 0 0 18px;
  }
  /* .vv-divider-gold-left（旧CONCEPTの金の横線）は 2026-09-04 に撤去。
     使っていたのは旧CONCEPTの1箇所だけで、そこを組み替えたため未使用になった。 */
  .eyebrow-light {
    color: rgba(255,255,255,0.8);
  }
  .section-h2-light {
    color: #fff;
  }
  .vv-sub-eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--color-primary);
    text-align: center;
    margin: 32px 0 24px;
  }

  /* HERO */
  .vv-hero {
    position: relative;
    /* 上下を7%ずつ詰めて、空いた14%を直下の予約ブロックに使う（2026-08-29 アキラさん指示） */
    height: 86vh;
    min-height: 520px;
    overflow: hidden;
    color: #fff;
  }
  /* ── ヒーロー直下の予約ブロック ──────────────────
     ヒーローを上下7%ずつ詰めて空けた14%に収める。 */
  .vv-bookbar {
    background: var(--color-surface, #efece4);
    border-bottom: 1px solid rgba(0,0,0,0.06);
  }
  .vv-bookbar-inner {
    max-width: 1400px;
    margin: 0 auto;
    /* 2026-09-03 アキラさん指示：ブロック全体を中央に置く。
       以前は右下の固定予約ボタン（150px）を避けるため右だけ160px余分に空けていたが、
       それが「少し左に寄って見える」原因だった。左右を同じ余白に戻し、
       中身を justify-content: center でまとめて中央に置く。
       固定ボタンとの重なりは、中央寄せで右端が空くので起きない（各幅で実測）。 */
    padding: 18px clamp(20px, 4vw, 36px);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: clamp(12px, 2vw, 28px);
    flex-wrap: wrap;
  }
  .vv-bookbar-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    /* 「日程未定」が増えて5列になったので、日付欄は伸びすぎないようにする。
       伸びしろはボタンに残す（はみ出させない）。 */
    flex: 1 1 150px;
    min-width: 130px;
    max-width: 230px;
  }
  .vv-bookbar-field label {
    font-family: var(--font-sans);
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--color-muted, #78716C);
  }
  .vv-bookbar-field input,
  .vv-bookbar-field select {
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--color-ink, #2c3a31);
    background: #fff;
    border: 1px solid rgba(0,0,0,0.14);
    border-radius: 2px;
    padding: 10px 12px;
    width: 100%;
  }
  .vv-bookbar-field input:focus-visible,
  .vv-bookbar-field select:focus-visible {
    outline: 2px solid var(--color-primary, #2a5a6e);
    outline-offset: 1px;
  }
  .vv-bookbar-guests { flex: 0 0 110px; min-width: 96px; }
  /* 日程が決まっていない人向け。チェックすると日付を送らず、
     押した先の空室カレンダーで選んでもらう。 */
  .vv-bookbar-flex {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 7px;
    padding-bottom: 11px;
  }
  .vv-bookbar-flex input { width: 16px; height: 16px; accent-color: var(--color-primary-darker, #0c1e26); }
  .vv-bookbar-flex label {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-ink, #2c3a31);
    cursor: pointer;
    white-space: nowrap;
  }
  /* 日程未定にしたとき、日付欄は残したまま操作できないことが分かるようにする */
  .vv-bookbar-field.is-off { opacity: 0.42; }
  .vv-bookbar-field.is-off input { pointer-events: none; background: #f3f1ec; }
  .vv-bookbar-submit {
    flex: 0 1 auto;
    /* 2026-09-03 アキラさん指示：margin-left:auto をやめる。
       これがボタンを右端まで飛ばし、「人数」との間に謎の空間を作っていた。
       外すと人数のすぐ隣に並ぶ。 */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 150px;
    padding: 13px clamp(18px, 2.4vw, 30px);
    background: var(--color-primary-darker, #0c1e26);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 15px;
    letter-spacing: 3px;
    text-decoration: none;
    border-radius: 2px;
    transition: background 0.3s ease;
  }
  .vv-bookbar-submit:hover { background: var(--color-primary, #2a5a6e); }
  .vv-bookbar-submit:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  @media (max-width: 700px) {
    /* 狭い画面は折り返すので、右下ボタンとぶつからない */
    .vv-bookbar-inner { gap: 12px; padding-bottom: 78px; }
    .vv-bookbar-submit { flex: 1 1 100%; }
  }

  .vv-hero-slides {
    position: absolute;
    inset: 0;
  }
  .vv-hero-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 3s ease;
    will-change: opacity;
  }
  .vv-hero-media.active { opacity: 1; }
  /* Photos only: a very slow, very slight push-in. Videos already move on their own. */
  .vv-hero-img {
    transform: scale(1);
    transform-origin: 50% 50%;
    transition: opacity 3s ease, transform 9s linear;
  }
  .vv-hero-img.vv-hero-zoom { transform: scale(1.18); }
  /* Used for one frame to snap the scale back without animating it */
  .vv-hero-media.vv-hero-noanim { transition: none; }
  /* 縦長の画面に横長写真を cover で入れると、天井と床という何も写っていない帯が
     画面の4割を占め、海やバーが中央の細い帯に潰れる。少し寄せて主題を大きく見せる。 */
  @media (max-width: 768px) {
    .vv-hero-img { transform: scale(1.28); }
    .vv-hero-img.vv-hero-zoom { transform: scale(1.46); }
    .vv-hero-video { transform: scale(1.14); }
  }
  @media (prefers-reduced-motion: reduce) {
    .vv-hero-media { transition: none; }
    .vv-hero-img,
    .vv-hero-img.vv-hero-zoom { transform: none; transition: none; }
  }
  .vv-hero-overlay {
    position: absolute;
    inset: 0;
    /* 全面を一律に暗くすると室内写真の深緑と木目が沈む。
       ヘッダーとCTAの周りだけ締めて、写真が見える帯は薄く抜く。 */
    background:
      /* 文字の背後だけを楕円で締める。7枚のうち一番明るいドローン映像でも読めるように。 */
      radial-gradient(ellipse 78% 58% at 50% 47%,
        rgba(6, 20, 28, 0.58) 0%,
        rgba(6, 20, 28, 0.34) 48%,
        rgba(6, 20, 28, 0.00) 100%),
      /* 上端はヘッダーの白文字、下端はCTAの座りを守るためだけに締める */
      linear-gradient(to bottom,
        rgba(8, 26, 34, 0.52) 0%,
        rgba(8, 26, 34, 0.14) 22%,
        rgba(8, 26, 34, 0.14) 72%,
        rgba(8, 26, 34, 0.50) 100%);
  }
  .vv-hero-content {
    position: relative;
    z-index: 2;
    /* 膜を薄くしたので、文字の影で背景から浮かせて可読性を保つ */
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.60), 0 2px 18px rgba(0, 0, 0, 0.45);
    height: 100%;
    display: flex;
    flex-direction: column;
    /* 2026-09-03 アキラさん指示：見出しはヒーローの「右下」へ。
       線画がその上に乗る形にするため、下寄せ＋右寄せにする。 */
    justify-content: flex-end;
    align-items: flex-end;
    text-align: right;
    /* 2026-09-03 アキラさん指示：英字（PRIVATE VILLA IN NANJO, OKINAWA）を
       いちばん下＝背景のすぐ上に置くので、下の余白を詰める。 */
    padding: 0 clamp(20px, 4vw, 56px) 16px;
  }
  /* 🔴 右下の3点（線画・見出し・英字）は横幅を揃える。
     基準＝英字の自然な幅（1440pxで実測402px）。この1つの変数で3つとも動く。 */
  .vv-hero-content {
    /* 2026-09-03 アキラさん指示：スマホは全体的に少し小さく（86vw → 78vw）。
       375pxで 323px → 292px。線画・見出し・クチコミ・英字が一緒に縮む。 */
    --hero-w: min(402px, 78vw);
  }
  .vv-hero-illust,
  .vv-hero-title,
  .vv-hero-rating,
  .vv-hero-eyebrow {
    width: var(--hero-w);
  }
  /* ── ヒーロー右下の線画（見出しの上に乗る）────────────
     白線・透過PNG。写真の上でも輪郭が残るよう軽く影を落とす。 */
  .vv-hero-illust {
    display: block;
    /* 幅は上の --hero-w で決まる（英字と同じ402px）。460pxから少し小さくなる。 */
    height: auto;
    margin: 0 0 8px;
    opacity: 0.92;
    filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.45));
    animation: fade-up 1s ease 0.4s both;
    pointer-events: none;
  }
  .vv-hero-eyebrow {
    font-family: var(--font-sans);
    /* 1440pxで従来どおり 11px / 字間6px。狭い画面では折り返さず比率で縮む
       （折り返すと線画・見出しと幅が揃わなくなるため）。 */
    font-size: calc(var(--hero-w) * 0.02736);
    letter-spacing: calc(var(--hero-w) * 0.01493);
    white-space: nowrap;
    text-transform: uppercase;
    opacity: 0.85;
    /* 2026-09-03 アキラさん指示：英字は線画の上。さらに「今の位置と、絵の中の鳥の
       中間くらい」まで下げる。鳥は画像の上から26.4%（canvasで実測）＝表示高226pxなら
       上から約60px。従来は絵の14px上だったので、中間＝絵の上から約23px下。
       負の余白で絵に重ねる（絵の上部は透過の空なので重なっても絵は隠れない）。 */
    margin: 0 0 calc(var(--hero-w) * -0.057);
    position: relative;
    z-index: 1;
    animation: fade-up 1s ease 0.3s both;
  }
  .vv-hero-title {
    font-family: var(--font-serif);
    /* 2026-09-03 アキラさん指示：横幅が線画・英字と同じになる大きさにする。
       8文字 ×（字送り＋字間）＝ --hero-w になるよう比率で出す（402px → 48px）。 */
    /* 2026-09-03 アキラさん指示：字間と行間を少し広げ、そのぶん文字を小さくして
       横幅は --hero-w のまま保つ。8文字 ×（文字＋字間）＝ --hero-w になる比率。
       字間 0.005→0.00995（402pxで2.0px→4.0px）／文字 0.1194→0.11505（48px→46.25px）
       ＝ 8 ×（46.25 + 4.0）＝ 402px で幅は変わらない。 */
    font-size: calc(var(--hero-w) * 0.11505);
    font-weight: 300;
    line-height: 1.5;
    letter-spacing: calc(var(--hero-w) * 0.00995);
    margin: 0 0 12px;
    white-space: pre-line;
    animation: fade-up 1s ease 0.5s both;
  }
  /* .vv-hero-divider（見出し下の短い横線）は 2026-09-03 アキラさん指示で削除。
     マークアップからも外したので、CSSもここで消している。 */
  .vv-hero-lead {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    opacity: 1;
    max-width: 560px;
    line-height: 1.8;
    margin: 0 0 36px;
    animation: fade-up 1s ease 0.9s both;
  }
  .vv-hero-cta {
    display: inline-block;
    padding: 18px 48px;
    background: linear-gradient(135deg, #1d6cd0 0%, #0a4a99 100%);
    color: #fff;
    border: 0;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 2px;
    text-decoration: none;
    box-shadow: 0 8px 28px rgba(13, 71, 161, 0.45),
                0 2px 6px rgba(0, 0, 0, 0.18),
                inset 0 1px 0 rgba(255, 255, 255, 0.18);
    transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
    animation: fade-up 1s ease 1.1s both, vv-hero-cta-pulse 2.6s ease-in-out 2.2s infinite;
    position: relative;
    overflow: hidden;
  }
  .vv-hero-cta::before {
    content: '';
    position: absolute;
    top: 0; left: -75%;
    width: 50%; height: 100%;
    background: linear-gradient(120deg, transparent 0%, rgba(255,255,255,0.35) 50%, transparent 100%);
    transform: skewX(-20deg);
    animation: vv-hero-cta-shine 3.4s ease-in-out 3s infinite;
    pointer-events: none;
  }
  .vv-hero-cta:hover {
    background: linear-gradient(135deg, #2680e5 0%, #0b56b0 100%);
    transform: translateY(-2px);
    box-shadow: 0 12px 36px rgba(13, 71, 161, 0.55),
                0 4px 10px rgba(0, 0, 0, 0.22),
                inset 0 1px 0 rgba(255, 255, 255, 0.22);
  }
  .vv-hero-cta:active { transform: translateY(0); }
  @keyframes vv-hero-cta-pulse {
    0%, 100% { box-shadow: 0 8px 28px rgba(13, 71, 161, 0.45), 0 2px 6px rgba(0,0,0,0.18), inset 0 1px 0 rgba(255,255,255,0.18); }
    50%      { box-shadow: 0 10px 36px rgba(29, 108, 208, 0.65), 0 2px 6px rgba(0,0,0,0.18), inset 0 1px 0 rgba(255,255,255,0.22); }
  }
  @keyframes vv-hero-cta-shine {
    0%   { left: -75%; }
    60%  { left: 125%; }
    100% { left: 125%; }
  }
  .vv-hero-rating {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 2px;
    /* クチコミ 9.4/10 は成約材料。読めない濃さにしない */
    opacity: 0.88;
    margin: 0;
    animation: fade-up 1s ease 1.3s both;
  }

  /* ── EXPERIENCE ─────────────────────────────────
     るうふ杉之家の実測値（1280px幅）を基準にした：
       見出し 120px／cormorant-garamond／weight 100／色 #969BA0
       左の写真 759×554／右のリード 縦書き・A1明朝19.5px・行間2.0・幅273×高さ448
     A1明朝は有料フォントで持っていないので、サイト既定の明朝（Shippori Mincho）を当てる。 */
  .vv-exp {
    padding: clamp(64px, 9vw, 120px) 0;
    background: var(--color-bg, #fff);
  }
  /* 2026-09-19 アキラさん指示：コンセプトと間取りの地色を入れ替える。
     コンセプト＝ページ既定の生成りに落とし、間取りを純白にして図面のカードと段差を作らない。
     #experience は純白のまま（.vv-exp の既定を共有しているので ID で上書きする）。 */
  #vv-concept-sec { background: var(--color-cream, #faf9f7); }
  #floormap { background: #fff; }
  .vv-exp-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 36px);
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: start;
  }
  /* 写真＝アキラさんがトリミングして支給した版（2026-09-03 17:24・1157×748）。
     元 HP掲載１.png 1.3MB を拡大せずJPEG化して233KBに。
     🔴 トリミングは既に画像側で済んでいるので、CSSでは切らない。
     枠の縦横比を画像と同じ 1157/748 にしてあるため `object-fit: cover` は
     実質なにも削らない（保険としてだけ置いている）。
     ここで別の縦横比を指定すると、切られた画像をさらに切ることになる。 */
  .vv-exp-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1157 / 748;
    object-fit: cover;
    /* 2026-09-03 アキラさん指示：少しだけ右へ。
       transform なので大きさも列の幅も変わらず、右の文章との間隔だけが詰まる。
       間隔は clamp(24px,4vw,64px) あるので、この移動量なら文章に触れない（実測で確認）。 */
    transform: translateX(clamp(12px, 2.2vw, 32px));
  }
  .vv-exp-text {
    display: flex;
    flex-direction: column;
    /* 横書きにしたので、リードは列いっぱいに広げる（flex-start だと内容幅に縮む） */
    align-items: stretch;
  }
  .vv-exp-heading {
    font-family: "Cormorant Garamond", var(--font-serif), serif;
    font-size: clamp(56px, 8.4vw, 120px);
    /* るうふは weight 100 だが、当サイトが読み込んでいる Cormorant Garamond は
       300 が最軽量（global.css の @import）。無い太さを指定すると偽の細字になるので 300 にする。 */
    font-weight: 300;
    line-height: 1;
    color: #969BA0;
    margin: 0 0 clamp(20px, 3vw, 40px);
    /* 左の写真の上端と頭を揃えるため、明朝の字面ぶんだけ持ち上げる */
    margin-top: -0.12em;
  }
  /* 2026-09-03 アキラさん指示：リード文は縦書きをやめて横書きにする。
     （るうふは縦書きだが、当サイトは横書きで通す判断） */
  .vv-exp-lead {
    font-family: var(--font-serif);
    /* 2026-09-03 アキラさん指示：本文をもう少し大きく（17 → 19px） */
    font-size: clamp(16px, 1.4vw, 19px);
    font-weight: 400;
    line-height: 2;
    letter-spacing: 0.02em;
    color: var(--color-ink, #2c3a31);
    margin: 0;
  }
  /* 2026-09-04 アキラさん指示：Space（CONCEPT）は写真と文章を左右逆にする。
     Experienceと交互になり、続けて並んでも単調にならない。
     列の比率も入れ替えるので、写真の大きさは Experience と同じまま。 */
  .vv-exp--rev .vv-exp-inner {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
  }
  /* 🔴 2026-09-04 アキラさん指摘：ヘッダーの固定縦線（画面左から234px・`.vv-side-rule`）が
     反転したブロックの見出しと本文を横切っていた（実測：文章が x=49 から始まっていた）。
     文章の始まりを縦線の右へ逃がす。縦線は900px以下では消えるので、それ以上の幅だけ効かせる。
     ⚠️ 逃がしたぶん文章の列が狭くなるので、写真との比率も 1.35 → 1.5 に振り直して
        文章に幅を戻している（写真は Experience より少しだけ小さくなる）。 */
  @media (min-width: 901px) {
    .vv-exp--rev .vv-exp-inner {
      /* 2026-09-04 アキラさん指示「右に寄せすぎ。その半分でいい」＝
         clamp(260px,18.5vw,300px) の半分。寄せを弱めたぶん文章の列が広がるので、
         写真も Experience の730pxに近づく。 */
      padding-left: clamp(130px, 9.25vw, 150px);
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    }
  }
  .vv-exp--rev .vv-exp-photo { grid-column: 2; grid-row: 1; }
  .vv-exp--rev .vv-exp-text  { grid-column: 1; grid-row: 1; }
  /* 写真の寄せも鏡にする（Experienceは右へ寄せているので、こちらは左へ）。 */
  .vv-exp--rev .vv-exp-photo { transform: translateX(calc(-1 * clamp(12px, 2.2vw, 32px))); }

  @media (max-width: 900px) {
    .vv-exp-inner {
      grid-template-columns: 1fr;
      gap: clamp(20px, 5vw, 36px);
    }
    /* 積み重なる幅では左右の入れ替えを解除し、写真が上・文章が下に戻す */
    .vv-exp--rev .vv-exp-inner { grid-template-columns: 1fr; }
    .vv-exp--rev .vv-exp-photo { grid-column: 1; grid-row: 1; }
    .vv-exp--rev .vv-exp-text  { grid-column: 1; grid-row: 2; }
    /* 🔴 反転側の寄せもここで解除する。`.vv-exp-photo { transform: none }` だけでは
       `.vv-exp--rev .vv-exp-photo` の方が詳細度が高くて勝ってしまい、
       写真だけ左へずれて左右の余白が不揃いになる（実測：390px幅で左8px・右32px）。 */
    .vv-exp--rev .vv-exp-photo { transform: none; }
    .vv-exp-text {
      flex-direction: column;
      align-items: stretch;
      gap: clamp(16px, 4vw, 28px);
    }
    .vv-exp-heading { margin: 0; }
    /* 狭い画面の文字サイズは、るうふ実測（390px幅で16.64px／行間2.0）に合わせる */
    .vv-exp-lead { font-size: clamp(15px, 4.3vw, 16.6px); }
    /* 🔴 写真の右シフトは「左に写真・右に文章」の並びのときだけ意味がある。
       積み重なる幅では写真が全幅になるので、右へずらすと左右の余白が
       不揃いになる（実測：390px幅で左32px・右8px）。ここでは解除する。 */
    .vv-exp-photo { transform: none; }
  }

  /* Grids */
  .vv-grid-3 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }
  .vv-grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
  }

  /* Facility card */
  .vv-fac-card {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--color-cream-darker);
    transition: transform 0.4s, box-shadow 0.4s;
  }
  .vv-fac-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0,0,0,0.08);
  }
  .vv-fac-img-wrap {
    height: 220px;
    overflow: hidden;
  }
  .vv-fac-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .vv-fac-card:hover .vv-fac-img-wrap img { transform: scale(1.05); }
  .vv-fac-body { padding: 22px 24px; }
  .vv-fac-body h3 {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 400;
    margin: 0 0 8px;
    color: var(--color-ink);
  }
  .vv-fac-body p {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--color-muted);
    line-height: 1.7;
    margin: 0;
  }

  /* Deal card */
  .vv-deal-card {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--color-cream-darker);
    display: flex;
    flex-direction: column;
  }
  .vv-deal-card img {
    width: 100%;
    height: 240px;
    object-fit: cover;
  }
  .vv-deal-body { padding: 28px 30px; }
  .vv-deal-body h3 {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 400;
    margin: 0 0 10px;
  }
  .vv-deal-body p {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--color-muted);
    line-height: 1.7;
    margin: 0 0 18px;
  }
  .vv-deal-card-primary {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: #fff;
    justify-content: center;
  }
  .vv-deal-card-primary .vv-deal-body h3 { color: #fff; }
  .vv-deal-card-primary .vv-deal-body p { color: rgba(255,255,255,0.85); }

  /* Dining */
  .vv-dining-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
  }
  .vv-dining-card {
    padding: 22px 24px;
    background: var(--color-cream);
    border: 1px solid var(--color-cream-darker);
    border-radius: 10px;
  }
  .vv-dining-card h4 {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 500;
    margin: 0 0 6px;
  }
  .vv-dining-cuisine {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--color-muted);
    margin: 0 0 8px;
  }
  .vv-dining-rating {
    font-family: var(--font-sans);
    color: var(--color-accent);
    font-size: 12px;
    margin: 0 0 6px;
  }
  .vv-dining-phone {
    font-family: var(--font-sans);
    color: var(--color-primary);
    font-size: 12px;
    text-decoration: none;
  }

  /* Attractions */
  .vv-att-card {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--color-cream-darker);
    transition: transform 0.4s, box-shadow 0.4s;
  }
  .vv-att-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0,0,0,0.08);
  }
  .vv-att-card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }
  .vv-att-body { padding: 18px 22px; }
  .vv-att-tag {
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-primary);
    margin: 0 0 6px;
  }
  .vv-att-body h4 {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 500;
    margin: 0 0 6px;
  }
  .vv-att-rating {
    font-family: var(--font-sans);
    color: var(--color-accent);
    font-size: 12px;
    margin: 0 0 8px;
  }
  .vv-att-desc {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--color-muted);
    line-height: 1.7;
    margin: 0;
  }

  /* Check-in */
  .vv-checkin-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    max-width: 720px;
    margin: 40px auto 28px;
  }
  .vv-checkin-cell { padding: 14px; }
  .vv-checkin-num {
    font-family: var(--font-serif);
    font-size: clamp(40px, 7vw, 72px);
    font-weight: 300;
    line-height: 1;
    margin: 0 0 8px;
    color: #fff;
  }
  .vv-checkin-num span {
    font-size: 0.5em;
    opacity: 0.6;
  }
  .vv-checkin-label {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    opacity: 0.8;
    margin: 0;
  }
  .vv-checkin-cta { margin-top: 8px; }

  /* Access */
  .vv-access-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 36px;
    align-items: start;
  }
  .vv-access-info p {
    font-family: var(--font-sans);
    color: var(--color-ink);
    line-height: 1.9;
    margin: 0 0 10px;
  }
  .vv-access-addr {
    font-size: 14px;
    line-height: 1.9;
    white-space: pre-line;
  }
  .vv-access-info ul {
    padding: 0;
    margin: 14px 0 22px;
    list-style: none;
  }
  .vv-access-info ul li {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--color-muted);
    padding: 4px 0;
    letter-spacing: 1px;
  }
  .vv-access-tel {
    color: var(--color-primary);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }
  @media (max-width: 768px) {
    .vv-access-grid {
      grid-template-columns: 1fr;
    }
    .vv-checkin-grid { gap: 16px; }
  }
  .vv-gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 12px;
  }
  .vv-gallery-cell {
    display: block;
    padding: 0;
    margin: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    overflow: hidden;
    border-radius: 8px;
    aspect-ratio: 4 / 3;
  }
  .vv-gallery-cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .vv-gallery-cell:hover img { transform: scale(1.05); }
  .vv-gallery-cell:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* FLOOR MAP（間取り） */
  .vv-fm-overview {
    display: none;            /* PC は本体の図がそのまま全景なので出さない */
    width: 100%;
    max-width: 420px;
    margin: 0 auto 18px;
    opacity: 0.85;
  }
  .vv-fm-tabs {
    display: none;            /* PC は 1F/2F を切り替えない（1枚で並んで見えている） */
    gap: 8px;
    justify-content: center;
    margin-bottom: 14px;
  }
  .vv-fm-tab {
    font-family: var(--font-sans);
    font-size: 13px;
    letter-spacing: 2px;
    padding: 8px 22px;
    background: transparent;
    color: var(--color-ink-soft);
    border: 1px solid var(--color-cream-darker);
    cursor: pointer;
  }
  .vv-fm-tab.is-on {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }
  /* 図面は1F・2Fの別画像。PC は元の全景と同じ見え方になるよう横に並べ、
     SP はタブで選んだ階だけを幅いっぱいに出す。画像を切り出してあるので、
     以前の「枠の中で面をずらす」拡大移動と、方位磁針を伏せる地色マスクは撤去した。 */
  .vv-fm-stage {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: clamp(12px, 3vw, 40px);
  }
  .vv-fm-fig { position: relative; margin: 0; }
  .vv-fm-map { display: block; width: 100%; height: auto; }
  .vv-fm-stage[data-fm-view="all"] .vv-fm-fig[data-fm-floor="1"] { flex: 0 1 62%; }
  .vv-fm-stage[data-fm-view="all"] .vv-fm-fig[data-fm-floor="2"] { flex: 0 1 33%; }
  .vv-fm-stage[data-fm-view="1"] .vv-fm-fig[data-fm-floor="2"],
  .vv-fm-stage[data-fm-view="2"] .vv-fm-fig[data-fm-floor="1"] { display: none; }
  .vv-fm-stage[data-fm-view="1"] .vv-fm-fig[data-fm-floor="1"] { flex: 1 1 100%; }
  .vv-fm-stage[data-fm-view="2"] .vv-fm-fig[data-fm-floor="2"] { flex: 1 1 100%; max-width: 330px; }

  .vv-fm-pin {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .vv-fm-pin-n {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-primary-darker);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
    transition: transform 0.2s, background 0.2s;
  }
  .vv-fm-pin:hover .vv-fm-pin-n { transform: scale(1.12); background: var(--color-primary); }
  .vv-fm-pin:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; }
  .vv-fm-note {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--color-muted);
    text-align: center;
    margin-top: 14px;
  }

  .vv-fm-list {
    list-style: none;
    padding: 0;
    margin: 26px auto 0;
    max-width: 1000px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px 20px;
  }
  .vv-fm-row {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 8px;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid transparent;
    cursor: pointer;
    text-align: left;
    transition: border-color 0.2s, background 0.2s;
  }
  .vv-fm-row:hover { background: #fff; border-color: var(--color-cream-darker); }
  .vv-fm-row:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .vv-fm-n {
    flex: 0 0 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-primary-darker);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 1;
  }
  .vv-fm-thumb { flex: 0 0 56px; width: 56px; height: 42px; object-fit: cover; }
  .vv-fm-rowtext { flex: 1 1 auto; display: flex; align-items: baseline; gap: 8px; min-width: 0; }
  .vv-fm-name {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .vv-fm-floor {
    flex: 0 0 auto;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--color-muted);
  }
  /* 寝具のピクト。台数分そのまま並べるので、読者が足し算をしなくても埋まり方が形で分かる。 */
  .vv-fm-beds { flex: 0 0 auto; display: flex; align-items: flex-end; gap: 4px; }
  .vv-fm-bed { display: block; background: var(--color-mitsu, #c08a4e); border-radius: 2px; }
  .vv-fm-bed--s    { width: 9px;  height: 14px; }
  .vv-fm-bed--d    { width: 16px; height: 14px; }
  .vv-fm-bed--sofa { width: 14px; height: 9px;  border-radius: 2px 2px 4px 4px; opacity: 0.75; }
  .vv-fm-bed--futon{ width: 9px;  height: 7px;  opacity: 0.75; }

  .vv-fm-cta { margin-top: 34px; }

  @media (max-width: 900px) {
    .vv-fm-overview { display: block; }
    .vv-fm-tabs { display: flex; }
    .vv-fm-list { grid-template-columns: 1fr; }
  }

  /* Lightbox */
  .vv-lightbox {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px;
    cursor: zoom-out;
    animation: vv-lb-fade 0.2s ease;
  }
  .vv-lightbox[hidden] { display: none; }
  @keyframes vv-lb-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .vv-lightbox img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    cursor: default;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
    border-radius: 4px;
  }
  .vv-lightbox button {
    position: absolute;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }
  .vv-lightbox button:hover { background: rgba(255, 255, 255, 0.25); }
  .vv-lightbox button[hidden] { display: none; }
  .vv-lightbox-close { top: 24px; right: 24px; }
  .vv-lightbox-prev { left: 24px; top: 50%; transform: translateY(-50%); }
  .vv-lightbox-next { right: 24px; top: 50%; transform: translateY(-50%); }
  .vv-lb-caption {
    position: absolute;
    left: 50%;
    bottom: 22px;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: 88%;
    padding: 7px 16px;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 13px;
    letter-spacing: 0.04em;
    line-height: 1.4;
    text-align: center;
  }
  .vv-lb-caption[hidden] { display: none; }
  /* その部屋に何枚あって今が何枚目か。文字を足さずに「同じ部屋の中で送っている」と分かる。 */
  .vv-lb-dots { display: flex; align-items: center; gap: 5px; margin-left: 2px; }
  .vv-lb-dots i {
    display: block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
  }
  .vv-lb-dots i.is-on { background: #fff; }
  /* 右下の固定「予約する」（z-index 1020）はライトボックスより手前に出るため、
     開いている間だけ引っ込める。375px では説明の帯とちょうど重なる。 */
  :global(html.vv-lb-open .vv-fix-book) { display: none; }
  .vv-lb-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.22);
    font-size: 11px;
    line-height: 1;
  }
  .vv-lb-num[hidden] { display: none; }
  @media (max-width: 600px) {
    .vv-lightbox { padding: 16px; }
  }
</style>

<script>
  // 2026-09-03：予約ブロックを中央寄せにしたので、右下の固定「予約する」ボタンが
  // 「空室を見る」に重なるようになった（1100px・900pxで実測）。
  // 以前は予約ブロックの右に160pxの余白を空けて避けていたが、それが
  // 「少し左に寄って見える」原因だったため撤去した。
  // 代わりに、予約ブロック自体が画面に見えている間は固定ボタンを引っ込める。
  // 本物の入力欄が目の前にあるとき、同じ行き先のボタンを重ねて出す意味がないため。
  {
    const bar = document.querySelector('.vv-bookbar');
    const fix = document.querySelector('.vv-fix-book');
    if (bar && fix) {
      // 固定ボタンが居座るのは画面右下の帯。予約ブロックがその帯にかかっている間だけ隠す。
      const BAND = 80; // 固定ボタンの高さ65px＋余裕
      const update = () => {
        const r = bar.getBoundingClientRect();
        const inBand = r.bottom > window.innerHeight - BAND && r.top < window.innerHeight;
        fix.classList.toggle('is-tucked', inBand);
      };
      // 1要素の getBoundingClientRect だけなので、間引かず直接呼んで問題ない。
      // （requestAnimationFrame で間引くと、裏に回ったタブで更新が止まる）
      addEventListener('scroll', update, { passive: true });
      addEventListener('resize', update);
      update();
    }
  }
</script>

<script>
  // 予約ブロックの入力を Beds24 のURLに載せる。
  // Beds24 が受けるのは checkin（YYYY-MM-DD）／numnight（泊数）／numadult（人数）。
  {
    const inEl  = document.getElementById('vv-bb-in');
    const outEl = document.getElementById('vv-bb-out');
    const gEl   = document.getElementById('vv-bb-guests');
    const go    = document.getElementById('vv-bb-go');

    if (inEl && outEl && gEl && go) {
      const base = go.getAttribute('href');
      const iso = (d) => d.toISOString().slice(0, 10);

      // 既定値＝明日から1泊。日付が未入力のままでも予約ページが開けるようにする。
      const t = new Date(); t.setDate(t.getDate() + 1);
      const t2 = new Date(t); t2.setDate(t2.getDate() + 1);
      inEl.value  = iso(t);
      outEl.value = iso(t2);
      inEl.min = iso(new Date());

      const flexEl = document.getElementById('vv-bb-flex');

      const sync = () => {
        // 日程未定にチェックが入っていたら、日付を送らずに空室カレンダーへ送る
        const flexible = flexEl && flexEl.checked;
        inEl.closest('.vv-bookbar-field').classList.toggle('is-off', flexible);
        outEl.closest('.vv-bookbar-field').classList.toggle('is-off', flexible);
        if (flexible) {
          const u = new URL(base);
          u.searchParams.delete('checkin');
          u.searchParams.delete('numnight');
          u.searchParams.set('numadult', gEl.value);
          go.setAttribute('href', u.toString());
          return;
        }
        const ci = inEl.value;
        const co = outEl.value;
        let nights = 1;
        if (ci && co) {
          const diff = (new Date(co) - new Date(ci)) / 86400000;
          if (diff >= 1) nights = Math.round(diff);
        }
        // チェックアウトはチェックイン翌日以降にしか選べないようにする
        if (ci) {
          const min = new Date(ci); min.setDate(min.getDate() + 1);
          outEl.min = iso(min);
          if (co && new Date(co) <= new Date(ci)) outEl.value = iso(min);
        }
        const url = new URL(base);
        url.searchParams.set('checkin', ci);
        url.searchParams.set('numnight', String(nights));
        url.searchParams.set('numadult', gEl.value);
        go.setAttribute('href', url.toString());
      };

      if (flexEl) flexEl.addEventListener('change', sync);
      inEl.addEventListener('change', sync);
      outEl.addEventListener('change', sync);
      gEl.addEventListener('change', sync);
      sync();
    }
  }
</script>

<script>
  // ライトボックス（2026-09-18 新規実装）。
  // それまで #vv-lightbox はマークアップと CSS だけが置かれていて開閉の処理が無く、
  // GALLERY のセルはクリックしても何も起きない状態だった。ここで1本にまとめ、
  // data-lb-group（gallery / floor）で写真群を分ける。前後送りは群の中だけで回る。
  {
    const box = document.getElementById('vv-lightbox');
    const imgEl = document.getElementById('vv-lightbox-img');
    const capEl = document.getElementById('vv-lightbox-cap');
    const numEl = document.getElementById('vv-lightbox-num');
    const capBar = document.getElementById('vv-lightbox-capbar');
    const dotsEl = document.getElementById('vv-lightbox-dots');

    if (box && imgEl) {
      const groups = {};
      document.querySelectorAll('script[data-lb-data]').forEach((el) => {
        try { groups[el.getAttribute('data-lb-data')] = JSON.parse(el.textContent || '[]'); }
        catch (e) { /* 壊れた JSON でページ全体を止めない */ }
      });

      let list = [];
      let idx = 0;
      let opener = null;

      const render = () => {
        const it = list[idx];
        if (!it) return;
        imgEl.src = it.src;
        imgEl.alt = it.alt || '';
        if (capEl) capEl.textContent = it.cap || '';
        // 説明の無い群（GALLERY）では帯ごと出さない。空の黒帯が写真の下に残るため。
        if (capBar) capBar.hidden = !it.cap;
        if (dotsEl) {
          // 2枚以上のときだけ出す。1枚しかない群でドットが1つ光っても意味がない。
          dotsEl.innerHTML = '';
          if (list.length > 1) {
            list.forEach((_, k) => {
              const d = document.createElement('i');
              if (k === idx) d.className = 'is-on';
              dotsEl.appendChild(d);
            });
          }
        }
        if (numEl) {
          numEl.textContent = it.n ? String(it.n) : '';
          numEl.hidden = !it.n;
        }
      };

      const open = (group, i) => {
        list = groups[group] || [];
        if (!list.length) return;
        idx = Math.min(Math.max(i, 0), list.length - 1);
        render();
        const prevBtn = box.querySelector('.vv-lightbox-prev');
        const nextBtn = box.querySelector('.vv-lightbox-next');
        if (prevBtn) prevBtn.hidden = list.length < 2;
        if (nextBtn) nextBtn.hidden = list.length < 2;
        box.hidden = false;
        document.body.style.overflow = 'hidden';
        document.documentElement.classList.add('vv-lb-open');
        const closeBtn = box.querySelector('.vv-lightbox-close');
        if (closeBtn) closeBtn.focus();
      };

      const close = () => {
        box.hidden = true;
        document.body.style.overflow = '';
        document.documentElement.classList.remove('vv-lb-open');
        if (opener) opener.focus();
      };

      const step = (d) => {
        if (!list.length) return;
        idx = (idx + d + list.length) % list.length;
        render();
      };

      document.querySelectorAll('[data-lb-group]').forEach((btn) => {
        btn.addEventListener('click', () => {
          opener = btn;
          open(btn.getAttribute('data-lb-group'), Number(btn.getAttribute('data-lb-idx') || 0));
        });
      });

      const on = (sel, fn) => {
        const el = box.querySelector(sel);
        if (el) el.addEventListener('click', fn);
      };
      on('.vv-lightbox-close', (e) => { e.stopPropagation(); close(); });
      on('.vv-lightbox-prev',  (e) => { e.stopPropagation(); step(-1); });
      on('.vv-lightbox-next',  (e) => { e.stopPropagation(); step(1); });
      // 余白のクリックで閉じる（写真そのものを押しても閉じない）
      box.addEventListener('click', (e) => { if (e.target === box) close(); });

      document.addEventListener('keydown', (e) => {
        if (box.hidden) return;
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowLeft') step(-1);
        else if (e.key === 'ArrowRight') step(1);
      });
    }
  }
</script>

<script>
  // 間取りの 1F / 2F 切替。900px 以下でだけ効かせ、それより広い画面では
  // 元画像のまま（1F と 2F が横に並んだ全景）を出す。
  {
    const stage = document.getElementById('vv-fm-stage');
    if (stage) {
      const tabs = Array.from(document.querySelectorAll('[data-fm-tab]'));
      const mq = window.matchMedia('(max-width: 900px)');
      let current = '1';

      const apply = () => {
        stage.setAttribute('data-fm-view', mq.matches ? current : 'all');
        tabs.forEach((t) => {
          const on = t.getAttribute('data-fm-tab') === current;
          t.classList.toggle('is-on', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
      };

      tabs.forEach((t) => t.addEventListener('click', () => {
        current = t.getAttribute('data-fm-tab') || '1';
        apply();
      }));

      if (mq.addEventListener) mq.addEventListener('change', apply);
      else mq.addListener(apply);
      apply();
    }
  }
</script>
