<script>
  // Hero slider rotation
  const slides = document.querySelectorAll<HTMLImageElement>('.vv-hero-img');
  if (slides.length > 1) {
    let idx = 0;
    setInterval(() => {
      slides[idx].classList.remove('active');
      idx = (idx + 1) % slides.length;
      slides[idx].classList.add('active');
    }, 5000);
  }
</script>
