---
import { withBase, localizedPath, getLangFromPath, useT } from '../i18n/utils';
import { FAQ_CATEGORIES, FAQ_T, pickText } from '../lib/faq-data';

const lang = getLangFromPath(Astro.url.pathname);
const t = useT(lang);
const homeHref = localizedPath('/', lang);
const contactHref = localizedPath('/contact/', lang);

// Fallback chain for FAQ-page-specific copy (only ja/en/zh translated)
const faqLang = (lang === 'en' || lang === 'zh') ? lang : (lang === 'ja' ? 'ja' : 'en');
const ft = FAQ_T[faqLang as 'ja' | 'en' | 'zh'];
---

<section class="vv-faq-hero" style={`background-image: linear-gradient(rgba(10,30,40,.55), rgba(10,30,40,.7)), url('${withBase('/images/hero-scenery.jpg')}')`}>
  <div class="vv-faq-hero-inner">
    <p class="vv-faq-eyebrow">VILLA VIEW</p>
    <h1 class="vv-faq-h1">{ft.title}</h1>
    <p class="vv-faq-sub">{ft.sub}</p>
    <div class="vv-divider-line"></div>
  </div>
</section>

<section class="vv-faq-section">
  <div class="vv-faq-body">
    <nav class="vv-faq-toc" aria-label="FAQ categories">
      {FAQ_CATEGORIES.map(cat => (
        <a href={`#${cat.id}`} class="vv-faq-toc-link">{pickText(cat.label, lang)}</a>
      ))}
    </nav>

    {FAQ_CATEGORIES.map(cat => (
      <section id={cat.id} class="vv-faq-cat">
        <h2 class="vv-faq-h2">{pickText(cat.label, lang)}</h2>
        <ul class="vv-faq-list">
          {cat.items.map(item => (
            <li class="vv-faq-item">
              <details>
                <summary>
                  <span class="vv-faq-q">{pickText(item.q, lang)}</span>
                  <span class="vv-faq-toggle" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                  </span>
                </summary>
                <div class="vv-faq-a">{pickText(item.a, lang)}</div>
              </details>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <p class="vv-faq-contact">
      {ft.contact}
      <a href={contactHref}>{t('nav.contact')}</a>
    </p>

    <p class="vv-faq-back">
      <a class="btn-outline" href={homeHref}>{ft.back}</a>
    </p>
  </div>
</section>

<style>
  .vv-faq-hero {
    background-size: cover;
    background-position: center center;
    padding: clamp(120px, 18vw, 200px) 20px clamp(60px, 8vw, 100px);
    color: #fff;
    text-align: center;
  }
  .vv-faq-hero-inner {
    max-width: 820px;
    margin: 0 auto;
  }
  .vv-faq-eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 6px;
    text-transform: uppercase;
    opacity: 0.8;
    margin: 0 0 18px;
  }
  .vv-faq-h1 {
    font-family: var(--font-serif);
    font-size: clamp(28px, 5vw, 44px);
    font-weight: 300;
    letter-spacing: 3px;
    margin: 0;
  }
  .vv-faq-sub {
    font-family: var(--font-sans);
    font-size: 13px;
    margin: 14px 0 0;
    opacity: 0.85;
    letter-spacing: 1px;
  }
  .vv-divider-line {
    width: 60px;
    height: 1px;
    background: rgba(255,255,255,0.6);
    margin: 22px auto 0;
  }

  .vv-faq-section {
    padding: clamp(50px, 8vw, 90px) clamp(20px, 5vw, 60px);
    background: var(--color-cream);
  }
  .vv-faq-body {
    max-width: 880px;
    margin: 0 auto;
  }

  .vv-faq-toc {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 36px;
    padding: 16px;
    background: #fff;
    border: 1px solid var(--color-cream-darker);
    border-radius: 12px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.04);
  }
  .vv-faq-toc-link {
    display: inline-block;
    padding: 8px 14px;
    background: var(--color-cream);
    color: var(--color-primary);
    font-family: var(--font-sans);
    font-size: 12px;
    letter-spacing: 1px;
    border: 1px solid var(--color-cream-darker);
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .vv-faq-toc-link:hover {
    background: var(--color-primary);
    color: #fff;
    border-color: var(--color-primary);
  }

  .vv-faq-cat { margin: 0 0 32px; scroll-margin-top: 100px; }
  .vv-faq-h2 {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 500;
    color: var(--color-primary);
    margin: 0 0 16px;
    padding-left: 14px;
    border-left: 3px solid var(--color-accent);
    letter-spacing: 1px;
  }
  .vv-faq-list { list-style: none; padding: 0; margin: 0; }
  .vv-faq-item {
    background: #fff;
    border: 1px solid var(--color-cream-darker);
    border-radius: 10px;
    margin-bottom: 10px;
    box-shadow: 0 1px 6px rgba(0,0,0,0.03);
    overflow: hidden;
  }
  .vv-faq-item details summary {
    list-style: none;
    cursor: pointer;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-ink);
    font-weight: 500;
    transition: background 0.2s;
  }
  .vv-faq-item details summary::-webkit-details-marker { display: none; }
  .vv-faq-item details summary:hover { background: var(--color-cream); }
  .vv-faq-q { flex: 1; }
  .vv-faq-toggle {
    flex-shrink: 0;
    color: var(--color-primary);
    transition: transform 0.25s ease;
    display: inline-flex;
    align-items: center;
  }
  .vv-faq-item details[open] .vv-faq-toggle { transform: rotate(180deg); }
  .vv-faq-a {
    padding: 4px 20px 18px;
    font-family: var(--font-sans);
    font-size: 13.5px;
    line-height: 1.9;
    color: var(--color-ink-soft);
    border-top: 1px solid var(--color-cream-darker);
    margin-top: -1px;
    padding-top: 16px;
    white-space: pre-wrap;
  }

  .vv-faq-contact {
    text-align: center;
    margin: 40px 0 0;
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--color-ink-soft);
  }
  .vv-faq-contact a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .vv-faq-back {
    text-align: center;
    margin-top: 32px;
  }
</style>
