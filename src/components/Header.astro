---
import { getLangFromPath, useT, localizedPath, LANGS, withBase } from '../i18n/utils';

const currentPath = Astro.url.pathname;
const lang = getLangFromPath(currentPath);
const t = useT(lang);

const homeHref = localizedPath('/', lang);
// Beds24 takes most of our lang codes as-is; map the few it differs on.
const beds24LangMap: Record<string, string> = {
  'zh-Hant': 'zh-Hant', ja: 'ja', en: 'en', zh: 'zh',
  ko: 'ko', th: 'th', hi: 'hi', fr: 'fr', de: 'de', es: 'es',
};
const beds24Lang = beds24LangMap[lang] ?? 'ja';
const bookingHref = `https://beds24.com/booking2.php?propid=322452&lang=${beds24Lang}&numnight=1`;

const navLinks = [
  { href: homeHref, label: t('nav.home') },
  { href: `${homeHref}#facilities`, label: t('nav.facilities') },
  { href: `${homeHref}#gallery`, label: t('nav.gallery') },
  { href: `${homeHref}#attractions`, label: t('nav.attractions') },
  { href: `${homeHref}#checkin`, label: t('nav.checkin') },
  { href: `${homeHref}#access`, label: t('nav.access') },
  { href: bookingHref, label: t('nav.booking') },
  { href: localizedPath('/faq/', lang), label: t('nav.faq') },
  { href: localizedPath('/contact/', lang), label: t('nav.contact') },
];

const currentLangLabel = LANGS.find(l => l.code === lang)?.native ?? lang;
---

<!-- ロゴはヘッダーの中に入れない。帯に飲み込まれると背景と反転しなくなるため、
     るうふ杉之家と同じく独立した固定要素にして、帯より手前へ置く。 -->
<section class="vv-logo-fixed">
  <a href={homeHref} aria-label="VILLA VIEW">
    <img src={withBase('/images/logo-full-white.png')} alt="VILLA VIEW" width="115" height="92" />
  </a>
</section>

<!-- 左サイドの縦の細い線（るうふ杉之家 .util_bar の実測＝幅1px・上下に余白）。
     ロゴ列とコンテンツ列を分ける罫。背景写真の上に乗るので、ロゴと同じく反転させる。 -->
<div class="vv-side-rule" aria-hidden="true"></div>

<!-- ロゴの下のメニューボタン（るうふ実測＝35×35 の中に 1px の横線2本）。
     デスクトップでも左サイドに出す。 -->
<button type="button" class="vv-side-burger" aria-label="メニュー" aria-expanded="false" aria-controls="vv-mobile-menu">
  <span class="l1"></span>
  <span class="l2"></span>
</button>

<!-- 右下に常時出る予約ボタン（るうふ杉之家 .block_fix_reservation の実測＝150×65px・
     right:0 bottom:0・濃色地に白文字・上段14px/字間4.2px・下段8px）。
     🔴 サブ文言は「当サイトがもっともお得」にしない。実測でOTAが安い日があり、
     根拠のない最安表示は景表法の有利誤認に当たる（赤①判定・pricing_design_policy）。 -->
<section class="vv-fix-book">
  <a href={bookingHref}>
    <span class="t01">{t('fixbook.main')}</span>
    <span class="t02">{t('fixbook.sub')}</span>
  </a>
</section>

<header id="vv-header" role="banner">
  <div class="vv-header-inner">

    <nav class="vv-nav-desktop" role="navigation">
      {navLinks.map(link => (
        <a href={link.href} class:list={['vv-nav-link', currentPath === link.href ? 'active' : '']}>{link.label}</a>
      ))}
    </nav>

    <div class="vv-lang-wrap" aria-label={t('lang.label')}>
      <button type="button" class="vv-lang-trigger" aria-haspopup="listbox" aria-expanded="false">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
        <span>{currentLangLabel}</span>
      </button>
      <ul class="vv-lang-menu" role="listbox">
        {LANGS.map(l => (
          <li>
            <a
              href={localizedPath(currentPath, l.code)}
              class:list={[l.code === lang ? 'active' : '']}
              data-lang={l.code}
            >{l.native}</a>
          </li>
        ))}
      </ul>
    </div>

    <button id="vv-burger" aria-label="Menu" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <div id="vv-mobile-menu">
    <button id="vv-mobile-close" aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M6 6l12 12M6 18L18 6" stroke-linecap="round"/>
      </svg>
    </button>
    <nav>
      {navLinks.map(link => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>
    <div class="vv-mobile-langs">
      {LANGS.map(l => (
        <a
          href={localizedPath(currentPath, l.code)}
          class:list={['vv-lang-pill', l.code === lang ? 'active' : '']}
          data-lang={l.code}
        >{l.native}</a>
      ))}
    </div>
  </div>
</header>

<style>
  /* ── 左サイドの縦罫 ──────────────────────────────
     るうふ杉之家の実測値（1440px幅）：幅1px／x=179／y=73／高さ747px
     ＝ 画面左から約12.4%の位置に、上下に余白を残して1本引く。 */
  .vv-side-rule {
    position: fixed;
    top: 72px;
    /* 2026-09-03 アキラさん指示：少し右へ。ロゴを170pxに拡大したので、
       ロゴの右端（左余白＋ロゴ幅）から28px右に置く＝1440pxで234px（従来179px）。
       ロゴ幅を変えても関係が崩れないよう計算で出す。 */
    left: calc(clamp(20px, 4vw, 36px) + var(--logo-w, 170px) + 28px);
    width: var(--rule-w, 0.25px);
    height: calc(100vh - 145px);
    background: #fff;
    mix-blend-mode: difference;
    z-index: 100;
    pointer-events: none;
  }

  /* ── ロゴの下のメニューボタン ────────────────────
     るうふ実測：35×35 の中に 1px の横線2本（間隔6px）。 */
  .vv-side-burger {
    position: fixed;
    /* ロゴの左右中央に揃える。ロゴの左端 ＋ ロゴ幅の半分 − ボタン幅の半分。
       ロゴの幅を変えても中央が保たれるよう計算で出す。 */
    left: calc(clamp(20px, 4vw, 36px) + (var(--logo-w, 170px) / 2) - 25px);
    /* ロゴを170pxへ拡大＝高さ136px（1280×1024）。ロゴ下端(18+136=154px)を避けて下げる。 */
    top: 226px;
    width: 50px;
    height: 50px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    mix-blend-mode: difference;
    z-index: 1010;
  }
  .vv-side-burger .l1,
  .vv-side-burger .l2 {
    position: absolute;
    left: 0;
    width: 50px;
    height: 1px;
    background: #fff;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  .vv-side-burger .l1 { top: 21px; }
  .vv-side-burger .l2 { top: 30px; }
  .vv-side-burger[aria-expanded="true"] .l1 { transform: translateY(4.5px) rotate(45deg); }
  .vv-side-burger[aria-expanded="true"] .l2 { transform: translateY(-4.5px) rotate(-45deg); }
  .vv-side-burger:focus-visible { outline: 1px solid #fff; outline-offset: 6px; }
  /* メニューが開いている間は、面の上で×として見えるように反転をやめて白線にする */
  .vv-side-burger[aria-expanded="true"] { mix-blend-mode: normal; z-index: 1200; }

  @media (max-width: 900px) {
    .vv-side-rule { display: none; }
    .vv-side-burger { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .vv-side-burger .l1, .vv-side-burger .l2 { transition: none; }
  }

  /* るうふと同じく、上部メニューはスクロールに合わせて流れて消える。
     最上部にだけ残す＝固定しない。ロゴ・縦罫・メニューボタンは fixed のまま残る。 */
  /* ── 右下の予約ボタン（常時表示・スクロールしても付いてくる）── */
  .vv-fix-book {
    position: fixed;
    right: 0;
    bottom: 0;
    z-index: 1020;
    transition: transform 0.35s ease, opacity 0.35s ease;
  }
  /* 予約ブロックが画面に出ている間は引っ込める（HomeContent.astro のJSが付け外しする）。
     中央寄せにした予約ブロックの「空室を見る」と重なるのを避けるため。 */
  .vv-fix-book.is-tucked {
    transform: translateY(100%);
    opacity: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .vv-fix-book { transition: none; }
  }
  .vv-fix-book a {
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 150px;
    height: 65px;
    padding: 15px 22px;
    background: var(--color-primary-darker, #0c1e26);
    color: #fff;
    text-decoration: none;
    transition: background 0.3s ease;
  }
  .vv-fix-book a:hover { background: var(--color-primary, #2a5a6e); }
  .vv-fix-book a:focus-visible { outline: 2px solid #fff; outline-offset: -4px; }
  .vv-fix-book .t01 {
    font-family: var(--font-sans);
    font-size: 14px;
    letter-spacing: 4.2px;
    line-height: 1.5;
  }
  .vv-fix-book .t02 {
    font-family: var(--font-sans);
    font-size: 9px;
    letter-spacing: 0.5px;
    opacity: 0.82;
    line-height: 1.4;
    margin-top: 2px;
  }
  @media (max-width: 700px) {
    .vv-fix-book a { width: 128px; height: 58px; padding: 12px 16px; }
    .vv-fix-book .t01 { font-size: 13px; letter-spacing: 3px; }
    .vv-fix-book .t02 { font-size: 8.5px; }
  }

  #vv-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(18, 40, 50, 0);
    transition: background 0.4s ease, backdrop-filter 0.4s ease;
  }
  /* スクロール時の帯はやめた（2026-08-29 アキラさん判断）。
     背景を敷くとロゴとナビが背景写真と反転できなくなるため。
     backdrop-filter は新しい合成の階層を作るので、これも置かない。 */
  #vv-header.scrolled {
    background: transparent;
  }
  /* 帯をやめたので、ナビ・言語切替・メニューボタンも背景と反転させる。
     ロゴと同じ difference。素材は白（文字色 #fff）のまま。 */
  .vv-header-inner {
    mix-blend-mode: difference;
    max-width: 1400px;
    margin: 0 auto;
    padding: 18px clamp(20px, 4vw, 36px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  /* 背景の明暗に合わせて色が反転する（るうふ杉之家と同じ手法・実測して確認）。
     difference は「素材の色 − 背景の色」なので、素材は必ず白のロゴを使う。
     黒いロゴだと |背景 − 0| ＝ 背景そのままになり、ロゴが消える。
     ヘッダーの中に入れず独立させているのは、帯や backdrop-filter が
     合成の階層を切ってしまい、背景写真と反転しなくなるため。 */
  .vv-logo-fixed {
    position: fixed;
    top: 18px;
    left: clamp(20px, 4vw, 36px);
    z-index: 1010;
    mix-blend-mode: difference;
    pointer-events: auto;
  }
  .vv-logo-fixed a { display: block; }
  .vv-logo-fixed img {
    display: block;
    width: var(--logo-w, 170px);
    height: auto;
  }
  @media (max-width: 768px) {
    .vv-logo-fixed img { width: calc(var(--logo-w, 170px) * 0.72); }
  }
  .vv-nav-desktop {
    display: flex;
    gap: 18px;
    align-items: center;
    margin-left: auto;
    margin-right: 16px;
  }
  .vv-nav-link {
    color: #fff;
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 14px;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 400;
    padding: 6px 0;
    position: relative;
    transition: opacity 0.3s;
    white-space: nowrap;
  }
  @media (max-width: 1200px) {
    .vv-nav-desktop { gap: 14px; }
    .vv-nav-link { font-size: 13px; letter-spacing: 1.5px; }
  }
  .vv-nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background: #fff;
    transition: width 0.4s ease;
  }
  .vv-nav-link:hover::after,
  .vv-nav-link.active::after { width: 100%; }

  /* Language dropdown */
  .vv-lang-wrap {
    position: relative;
    display: inline-flex;
  }
  .vv-lang-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 1px;
    cursor: pointer;
    transition: background 0.3s, border-color 0.3s;
  }
  .vv-lang-trigger:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.4);
  }
  .vv-lang-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    background: #fff;
    border: 1px solid var(--color-cream-darker);
    border-radius: 4px;
    padding: 4px 0;
    margin: 0;
    list-style: none;
    min-width: 150px;
    max-height: 320px;
    overflow-y: auto;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.18);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.2s, visibility 0.2s, transform 0.2s;
    z-index: 110;
  }
  .vv-lang-wrap:hover .vv-lang-menu,
  .vv-lang-wrap:focus-within .vv-lang-menu,
  .vv-lang-wrap.open .vv-lang-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .vv-lang-menu li { list-style: none; }
  .vv-lang-menu a {
    display: block;
    padding: 8px 14px;
    color: #333;
    font-family: var(--font-sans);
    font-size: 13px;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .vv-lang-menu a:hover {
    background: var(--color-cream);
    color: var(--color-primary);
  }
  .vv-lang-menu a.active {
    background: var(--color-primary);
    color: #fff;
  }

  /* Mobile burger */
  #vv-burger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    color: #fff;
    padding: 6px;
  }
  /* 2026-09-03 アキラさん指示：ハンバーガーを大きく（28px → 40px）。
     ロゴ下の .vv-side-burger（35→50px）と揃える。 */
  #vv-burger svg { width: 40px; height: 40px; display: block; }

  /* 2026-09-03：ロゴを115px→170pxに拡大したことで、固定ロゴ（左上・幅170px）と
     上部ナビ9項目が 1100px 以下で重なった（実測：940px幅でナビ先頭が116px食い込む）。
     ロゴは大きいままにしたいので、ナビを畳む幅を 900px → 1100px へ上げる。
     畳んだ幅ではロゴ直下のメニューボタン（.vv-side-burger・900px以上で表示）が
     ナビを引き受けるので、どの幅でもメニューには到達できる。 */
  @media (max-width: 1100px) {
    .vv-nav-desktop, .vv-lang-wrap { display: none; }
    #vv-burger { display: block; margin-left: auto; }
  }

  /* Mobile menu drawer */
  #vv-mobile-menu {
    position: fixed;
    top: 0;
    right: 0;
    height: 100%;
    width: min(320px, 86vw);
    background: var(--color-primary-darker);
    color: #fff;
    transform: translateX(100%);
    transition: transform 0.3s ease;
    z-index: 120;
    padding: 60px 28px 28px;
    overflow-y: auto;
  }
  #vv-mobile-menu.open { transform: translateX(0); }
  #vv-mobile-close {
    position: absolute;
    top: 14px;
    right: 14px;
    background: none;
    border: none;
    color: #fff;
    padding: 6px;
    cursor: pointer;
  }
  #vv-mobile-close svg { width: 26px; height: 26px; display: block; }
  #vv-mobile-menu nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 28px;
  }
  #vv-mobile-menu nav a {
    color: #fff;
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 13px;
    letter-spacing: 3px;
    text-transform: uppercase;
    padding: 14px 6px;
    border-bottom: 1px solid rgba(255,255,255,0.12);
  }
  .vv-mobile-langs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-top: 16px;
    border-top: 1px solid rgba(255,255,255,0.12);
  }
  .vv-lang-pill {
    display: inline-block;
    padding: 6px 12px;
    border: 1px solid rgba(255,255,255,0.35);
    border-radius: 3px;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 1px;
    text-decoration: none;
  }
  .vv-lang-pill.active {
    background: #fff;
    color: var(--color-primary-darker);
  }
</style>

<script>
  const header = document.getElementById('vv-header');
  const burger = document.getElementById('vv-burger');
  const closeBtn = document.getElementById('vv-mobile-close');
  const mobileMenu = document.getElementById('vv-mobile-menu');

  function onScroll() {
    if (window.scrollY > 40) header?.classList.add('scrolled');
    else header?.classList.remove('scrolled');
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // 左サイドのメニューボタン（デスクトップ）。上部ナビと同じ中身を出す。
  // メニュー構成が決まったら、この1つのメニューを直せば両方に反映される。
  const sideBurger = document.querySelector<HTMLButtonElement>('.vv-side-burger');

  function openMenu() {
    mobileMenu?.classList.add('open');
    burger?.setAttribute('aria-expanded', 'true');
    sideBurger?.setAttribute('aria-expanded', 'true');
  }
  function closeMenu() {
    mobileMenu?.classList.remove('open');
    burger?.setAttribute('aria-expanded', 'false');
    sideBurger?.setAttribute('aria-expanded', 'false');
  }

  burger?.addEventListener('click', openMenu);
  sideBurger?.addEventListener('click', () => {
    // 開いているときは閉じる（2本線と×が対応するように）
    if (mobileMenu?.classList.contains('open')) closeMenu();
    else openMenu();
  });
  closeBtn?.addEventListener('click', closeMenu);
  // メニュー内のリンクを押したら閉じる
  mobileMenu?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));
  // Esc でも閉じる
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileMenu?.classList.contains('open')) closeMenu();
  });

  // Persist language preference
  document.querySelectorAll<HTMLAnchorElement>('[data-lang]').forEach(a => {
    a.addEventListener('click', () => {
      try { localStorage.setItem('vv-lang', a.dataset.lang || 'ja'); } catch {}
    });
  });
</script>
