---
import Layout from '../layouts/Layout.astro';
import { useT, getLangFromPath } from '../i18n/utils';

const pageLang = getLangFromPath(Astro.url.pathname);
const t = useT(pageLang);
const propid = '322452';
const beds24Url = `https://beds24.com/booking2.php?propid=${propid}&lang=${pageLang}&numnight=1`;

const lodgingSchema = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: 'VILLA VIEW',
  url: 'https://villaokinawa.com',
  telephone: '+81-98-894-2474',
  image: ['https://villaokinawa.com/images/hero-scenery.jpg'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: '1663-9 Tsukishiro',
    addressLocality: 'Nanjo',
    addressRegion: 'Okinawa',
    postalCode: '901-1407',
    addressCountry: 'JP',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 26.162946, longitude: 127.7936485 },
  checkinTime: '15:00',
  checkoutTime: '10:00',
  priceRange: '¥¥¥',
};
---
<Layout
  title={t('page.title.booking')}
  description={t('page.desc.booking')}
  noFooter
  schemas={[lodgingSchema]}
>
  <iframe
    id="booking-frame"
    src={beds24Url}
    title="Reservation"
    allow="payment"
    referrerpolicy="strict-origin-when-cross-origin"
  ></iframe>

  <script is:inline>
    // Forward URL query params from this wrapper into the Beds24 iframe so
    // Google Hotel Ads / utm_* / pre-filled dates land in the booking flow.
    (function () {
      var el = document.getElementById('booking-frame');
      if (!el || typeof URL === 'undefined' || typeof URLSearchParams === 'undefined') return;
      var parentQs = window.location.search;
      if (!parentQs || parentQs === '?') return;
      var pass = [
        'numadult','numAdult','numroom','numRoom','numchild','numChild',
        'checkin','checkIn','checkout','checkOut','priceId','lang','numnight','roomid','roomId',
        'arrivalDate','departureDate','room1NumAdults','room1NumChildren','numRooms','rooms',
        'utm_source','utm_medium','utm_campaign','utm_content','utm_term',
        'gclid','dclid','dsclid','gad_source','fbclid','msclkid','WT.mc_id',
      ];
      try {
        var u = new URL(el.getAttribute('src'), window.location.origin);
        var pp = new URLSearchParams(parentQs.slice(1));
        for (var i = 0; i < pass.length; i++) {
          var v = pp.get(pass[i]);
          if (v != null && String(v).trim() !== '') u.searchParams.set(pass[i], v);
        }
        el.src = u.toString();
      } catch (e) {}
    })();
  </script>
</Layout>

<style is:global>
  iframe#booking-frame {
    display: block;
    width: 100%;
    /* Below the site header. Header.astro is sticky/fixed at ~64-80px depending on viewport. */
    height: calc(100vh - 80px);
    min-height: 700px;
    border: 0;
    background: #fff;
  }
  @media (max-width: 768px) {
    iframe#booking-frame { height: calc(100vh - 64px); min-height: 600px; }
  }
</style>
