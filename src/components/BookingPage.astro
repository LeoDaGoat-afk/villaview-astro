---
import { getLangFromPath, useT, localizedPath, withBase } from '../i18n/utils';
import BookingWidget from './BookingWidget.astro';

const lang = getLangFromPath(Astro.url.pathname);
const t = useT(lang);

const gallery = [
  '/images/guestroom/guestroom2.jpg',
  '/images/guestroom/washitu.jpg',
  '/images/guestroom/terrace.jpg',
  '/images/yogastudio/living-room-oceanview.jpg',
  '/images/yogastudio/IMG_4715.jpg',
  '/images/coffee/coffeearea2.jpg',
  '/images/bbq/IMG_7211.jpg',
  '/images/therapy/IMG_5915.jpg',
  '/images/hero-scenery.jpg',
  '/images/night-view.jpg',
  '/images/view2.jpg',
];
---

<!-- Hero -->
<section class="bp-hero">
  <div class="bp-hero-slides">
    {gallery.slice(0, 4).map((src, i) => (
      <img src={withBase(src)} alt="" class:list={['bp-hero-img', i === 0 ? 'active' : '']} data-idx={i} loading={i === 0 ? 'eager' : 'lazy'} />
    ))}
  </div>
  <div class="bp-hero-overlay"></div>
  <div class="bp-hero-content">
    <p class="vv-hero-eyebrow">VILLA VIEW</p>
    <h1 class="bp-h1">{t('booking.heading')}</h1>
    <div class="vv-hero-divider"></div>
    <p class="bp-lead">{t('booking.lead')}</p>
  </div>
</section>

<!-- Booking widget -->
<section class="bp-section">
  <div class="bp-container">
    <div class="card-soft bp-widget-card">
      <BookingWidget />
      <div class="bp-badges">
        <span class="bp-badge"><span class="bp-badge-dot"></span>{t('booking.badge.bestPrice')}</span>
        <span class="bp-badge"><span class="bp-badge-dot"></span>{t('booking.badge.noFees')}</span>
        <span class="bp-badge"><span class="bp-badge-dot"></span>{t('booking.badge.instant')}</span>
      </div>
    </div>
  </div>
</section>

<!-- Photo gallery -->
<section class="bp-section bp-section-cream">
  <div class="bp-container">
    <div class="bp-section-head">
      <p class="eyebrow">VILLA VIEW</p>
      <h2 class="section-h2">{t('exp.eyebrow') /* Photo gallery placeholder uses generic key */}</h2>
    </div>
    <div class="bp-gallery">
      {gallery.map(src => (
        <img src={withBase(src)} alt="" loading="lazy" />
      ))}
    </div>
  </div>
</section>

<!-- Access -->
<section class="bp-section">
  <div class="bp-container">
    <div class="bp-section-head">
      <p class="eyebrow">{t('access.eyebrow')}</p>
      <h2 class="section-h2">{t('access.title')}</h2>
      <div class="vv-divider-gold-center"></div>
    </div>
    <div class="bp-access">
      <div>
        <p class="bp-access-addr">{t('access.address')}</p>
        <ul>
          <li>{t('access.detail1')}</li>
          <li>{t('access.detail2')}</li>
          <li>{t('access.detail3')}</li>
        </ul>
        <p><a class="bp-access-tel" href="tel:+81988942474">{t('access.tel')}</a></p>
        <a href="https://www.google.com/maps/search/?api=1&query=26.162946,127.7936485" target="_blank" rel="noopener noreferrer" class="btn-outline">{t('access.map')}</a>
      </div>
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d3581.5!2d127.7936485!3d26.162946!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMjbCsDA5JzQ2LjYiTiAxMjfCsDQ3JzM3LjEiRQ!5e0!3m2!1sja!2sjp"
        title="VILLA VIEW Map"
        width="100%"
        height="380"
        style="border: 0; border-radius: 12px;"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>
</section>

<!-- Policy summary -->
<section class="bp-policy-section">
  <div class="bp-container-narrow">
    <h3 class="bp-policy-eyebrow">{t('policy.heading')}</h3>
    <div class="bp-policy-text">
      <p><strong>{t('policy.cancelLabel')}</strong>{t('policy.cancelText')}</p>
      <p><strong>{t('policy.timesLabel')}</strong>{t('policy.timesText')}</p>
      <p><strong>{t('policy.rulesLabel')}</strong>{t('policy.rulesText')}</p>
    </div>
    <div class="bp-policy-links">
      <a href={localizedPath('/terms/', lang)}>{t('policy.termsLink')} →</a>
      <a href={localizedPath('/privacy/', lang)}>{t('policy.privacyLink')} →</a>
      <a href={localizedPath('/contact/', lang)}>{t('policy.contactLink')} →</a>
    </div>
  </div>
</section>

<style>
  .bp-container {
    max-width: 1100px;
    margin: 0 auto;
  }
  .bp-container-narrow {
    max-width: 720px;
    margin: 0 auto;
  }
  .bp-section {
    padding: clamp(50px, 8vw, 90px) clamp(20px, 5vw, 60px);
  }
  .bp-section-cream { background: var(--color-cream-dark); }
  .bp-section-head {
    text-align: center;
    margin-bottom: clamp(36px, 6vw, 60px);
  }
  .bp-section-head .eyebrow {
    margin-bottom: 12px;
  }

  /* HERO */
  .bp-hero {
    position: relative;
    height: 50vh;
    min-height: 360px;
    overflow: hidden;
    color: #fff;
  }
  .bp-hero-slides {
    position: absolute;
    inset: 0;
  }
  .bp-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.5s ease;
  }
  .bp-hero-img.active { opacity: 1; }
  .bp-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(10, 30, 40, 0.4), rgba(10, 30, 40, 0.65));
  }
  .bp-hero-content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 0 20px;
  }
  .bp-h1 {
    font-family: var(--font-serif);
    font-size: clamp(30px, 5vw, 52px);
    font-weight: 300;
    letter-spacing: 4px;
    margin: 0 0 12px;
  }
  .bp-lead {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 300;
    opacity: 0.85;
    max-width: 520px;
    line-height: 1.7;
  }

  .bp-widget-card {
    border-color: rgba(42, 90, 110, 0.15);
    background: linear-gradient(135deg, #ffffff 0%, #f6fafb 100%);
  }
  .bp-badges {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--color-cream-darker);
    flex-wrap: wrap;
  }
  .bp-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--color-muted);
  }
  .bp-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: var(--color-primary);
  }

  .bp-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 8px;
  }
  .bp-gallery img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: 8px;
    transition: transform 0.4s, opacity 0.4s;
  }
  .bp-gallery img:hover {
    transform: scale(1.03);
    opacity: 0.92;
  }

  .bp-access {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 36px;
    align-items: start;
  }
  .bp-access-addr {
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.9;
    margin: 0 0 14px;
    white-space: pre-line;
  }
  .bp-access ul {
    padding: 0;
    margin: 0 0 22px;
    list-style: none;
  }
  .bp-access ul li {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--color-muted);
    padding: 4px 0;
  }
  .bp-access-tel {
    color: var(--color-primary);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    display: inline-block;
    margin-bottom: 16px;
  }
  @media (max-width: 768px) {
    .bp-access {
      grid-template-columns: 1fr;
    }
  }

  /* Policy summary */
  .bp-policy-section {
    background: var(--color-cream-dark);
    padding: 50px 20px;
    border-top: 1px solid var(--color-cream-darker);
  }
  .bp-policy-eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--color-primary-dark);
    margin: 0 0 18px;
    font-weight: 600;
  }
  .bp-policy-text p {
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.9;
    color: var(--color-ink-soft);
    margin: 0 0 10px;
  }
  .bp-policy-text p strong {
    color: var(--color-primary-dark);
  }
  .bp-policy-links {
    display: flex;
    gap: 18px;
    margin-top: 18px;
    flex-wrap: wrap;
  }
  .bp-policy-links a {
    color: var(--color-primary);
    font-family: var(--font-sans);
    font-size: 12px;
    letter-spacing: 1px;
    text-decoration: underline;
  }
</style>

<script>
  // Hero booking slider
  const slides = document.querySelectorAll<HTMLImageElement>('.bp-hero-img');
  if (slides.length > 1) {
    let idx = 0;
    setInterval(() => {
      slides[idx].classList.remove('active');
      idx = (idx + 1) % slides.length;
      slides[idx].classList.add('active');
    }, 4500);
  }
</script>
